@{
    ViewData["Title"] = "Inicio";
}

@model List<ProductoDestacadoDto>


<!-- =====================================================
     HERO
     ===================================================== -->

<section class="home-hero">

    <div class="home-hero-overlay"></div>

    <div class="home-hero-content">

        <span class="home-welcome">
            Bienvenido a
        </span>

        <h1>
            Block du <span>Booster</span>
        </h1>

        <h2>
            Tu destino para cartas coleccionables
        </h2>

        <p>
            Encuentra tus cartas favoritas de
            Yu-Gi-Oh!, Pokémon, Magic y mucho más.
            Colecciona, intercambia y forma parte
            de nuestra comunidad de duelistas y
            coleccionistas.
        </p>


        <div class="home-buttons">

            <a asp-controller="Categorias"
               asp-action="Index"
               class="btn-primary-pix">

                <i class="bi bi-cart3"></i>

                Ver productos

            </a>


            <a asp-controller="Categorias"
               asp-action="Categorias"
               class="btn-outline-pix">

                <i class="bi bi-grid"></i>

                Explorar categorías

            </a>

        </div>

    </div>

</section>


<!-- =====================================================
     CATEGORÍAS
     ===================================================== -->

<section class="home-categories">

    <a asp-controller="Categorias"
       asp-action="Index"
       class="category-box yugioh">

        <div class="category-logo">
            Yu-Gi-Oh!
        </div>

        <span>
            Yu-Gi-Oh!
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>


    <a asp-controller="Categorias"
       asp-action="Index"
       class="category-box pokemon">

        <div class="category-logo">
            Pokémon
        </div>

        <span>
            Pokémon
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>


    <a asp-controller="Categorias"
       asp-action="Index"
       class="category-box magic">

        <div class="category-logo">
            MAGIC
        </div>

        <span>
            Magic
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>


    <a href="#" class="category-box others">

        <div class="category-logo">
            <i class="bi bi-stack"></i>
        </div>

        <span>
            Otros
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>

</section>


<!-- =====================================================
     PRODUCTOS DESTACADOS
     ===================================================== -->

<section class="featured-products">

    <div class="section-heading">

        <h2>
            <i class="bi bi-star-fill"></i>
            Productos destacados
        </h2>

        <a asp-controller="Categorias"
           asp-action="Index">

            Ver todos los productos
            <i class="bi bi-arrow-right"></i>

        </a>

    </div>


    <div class="featured-grid">

        @if (ViewBag.ApiError != null)
        {
            <div class="store-empty">
                <i class="bi bi-cloud-slash" style="font-size: 2.5rem; color: #9aadb8;"></i>
                <p class="mb-0 mt-2">@ViewBag.ApiError</p>
            </div>
        }
        else if (!Model.Any())
        {
            <div class="store-empty">
                <i class="bi bi-inbox" style="font-size: 2.5rem; color: #9aadb8;"></i>
                <p class="mb-0 mt-2">Aún no hay ventas registradas. ¡Los productos destacados aparecerán aquí!</p>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary mt-3">
                    Ver productos
                </a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var claseJuego = item.Juego switch
                {
                    "Yu-Gi-Oh!" => "yugioh-tag",
                    "Pokémon" => "pokemon-tag",
                    "Magic: The Gathering" => "magic-tag",
                    _ => "magic-tag"
                };

                <article class="featured-card">

                    <div class="product-image">

                        <img src="@Api.UrlImagen(item.ImagenRuta, Url.Content("~/Imagenes/imagen1.jpg"))"
                             alt="@item.Nombre" />

                    </div>

                    <div class="product-info">

                        <span class="product-game @claseJuego">
                            @item.Juego
                        </span>

                        <h3>
                            @item.Nombre
                        </h3>

                        <span class="product-rarity">
                            @item.Rareza
                        </span>

                        <strong class="product-price">
                            Bs @item.Precio.ToString("N2")
                        </strong>

                        @if (item.Stock <= 0)
                        {
                            <button class="add-cart"
                                    type="button"
                                    disabled
                                    style="background:#cfe0e8;cursor:not-allowed;color:#577b95;">
                                Agotado
                            </button>
                        }
                        else
                        {
                            <form method="post"
                                  asp-controller="Carrito"
                                  asp-action="Agregar"
                                  style="margin: 0;">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit" class="add-cart">
                                    <i class="bi bi-cart3"></i>
                                    Agregar al carrito
                                </button>

                            </form>
                        }

                    </div>

                </article>
            }
        }

    </div>

</section>