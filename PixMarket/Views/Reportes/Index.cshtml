@model PixMarket.Servicios.ReporteGeneralDto
@{
    ViewData["Title"] = "Reportes";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Reportes</h1>
                    <p>Analiza el rendimiento de tu tienda con los datos clave.</p>
                </div>
                <a asp-controller="Reportes" asp-action="DescargarPdfReporte" class="btn btn-success" style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; height: fit-content;">
                    <i class="bi bi-download"></i> Exportar
                </a>
            </div>

            <div class="admin-stats">

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ingresos totales</span>
                        <h3>Bs @(Model?.IngresosTotales.ToString("N2") ?? "0.00")</h3>
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Pedidos completados</span>
                        <h3>@(Model?.PedidosCompletados ?? 0)</h3>
                    </div>
                </div>

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Clientes nuevos</span>
                        <h3>@(Model?.ClientesNew ?? 0)</h3>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-star"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Producto top</span>
                        <h3>@(Model?.ProductoTop ?? "N/A")</h3>
                    </div>
                </div>

            </div>

            
            <div class="admin-grid">

                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-bar-chart-line"></i> Ventas por día</h3>
                        <select>
                            <option>Últimos 30 días</option>
                            <option>Últimos 7 días</option>
                        </select>
                    </div>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="graficoVentasDia"></canvas>
                    </div>
                </div>

                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-pie-chart"></i> Ventas por juego</h3>
                        <select>
                            <option>Este mes</option>
                            <option>Este año</option>
                        </select>
                    </div>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="graficoVentasJuego"></canvas>
                    </div>
                </div>

            </div>

            
            <div class="admin-panel full-width">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-trophy"></i> Productos más vendidos</h3>
                    <span>Este mes</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Carta</th>
                                <th>Juego</th>
                                <th>Precio</th>
                                <th>Unidades</th>
                                <th>Ingresos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.ProductosTopList != null && Model.ProductosTopList.Any())
                            {
                                int contador = 1;
                                foreach (var prod in Model.ProductosTopList)
                                {
                                    <tr>
                                        <td>@contador</td>
                                        <td>@prod.NombreCarta</td>
                                        <td>@prod.Juego</td>
                                        <td>Bs @prod.PrecioUnitario.ToString("N2")</td>
                                        <td>@prod.UnidadesVendidas</td>
                                        <td>Bs @prod.IngresosTotales.ToString("N2")</td>
                                    </tr>
                                    contador++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; padding: 2rem; color: #6c757d;">
                                        No hay registros de ventas para este periodo.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const datosDia = @Html.Raw(Json.Serialize(ViewBag.VentasDia ?? new List<object>()));
        const datosJuego = @Html.Raw(Json.Serialize(ViewBag.VentasJuego ?? new List<object>()));

        const ctxDia = document.getElementById('graficoVentasDia').getContext('2d');
        new Chart(ctxDia, {
        type: 'line',
        data: {
        labels: datosDia.map(x => x.fecha || x.Fecha),
        datasets: [{
        label: 'Ventas Totales (Bs)',
        data: datosDia.map(x => x.total || x.Total),
        borderColor: '#10afa5',
        backgroundColor: 'rgba(16, 175, 165, 0.1)',
        borderWidth: 2,
        fill: true,
        tension: 0.3
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false
        }
        });

        const ctxJuego = document.getElementById('graficoVentasJuego').getContext('2d');
        new Chart(ctxJuego, {
        type: 'doughnut',
        data: {
        labels: datosJuego.map(x => x.juego || x.Juego),
        datasets: [{
        data: datosJuego.map(x => x.total || x.Total),
        backgroundColor: ['#10afa5', '#36A2EB', '#FFCE56', '#FF6384', '#9966FF']
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false
        }
        });
    </script>
}