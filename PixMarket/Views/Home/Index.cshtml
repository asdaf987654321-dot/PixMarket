@{
    ViewData["Title"] = "Inicio";
}


<!-- =====================================================
     HERO
     ===================================================== -->

<section class="home-hero">

    <div class="home-hero-overlay"></div>

    <div class="home-hero-content">

        <span class="home-welcome">
            Bienvenido a
        </span>

        <h1>
            Block du <span>Booster</span>
        </h1>

        <h2>
            Tu destino para cartas coleccionables
        </h2>

        <p>
            Encuentra tus cartas favoritas de
            Yu-Gi-Oh!, Pokémon, Magic y mucho más.
            Colecciona, intercambia y forma parte
            de nuestra comunidad de duelistas y
            coleccionistas.
        </p>


        <div class="home-buttons">

            <a href="#" class="btn-primary-pix">

                <i class="bi bi-cart3"></i>

                Ver productos

            </a>


            <a asp-controller="Categorias"
               asp-action="Index"
               class="btn-outline-pix">

                <i class="bi bi-grid"></i>

                Explorar categorías

            </a>

        </div>

    </div>

</section>


<!-- =====================================================
     CATEGORÍAS
     ===================================================== -->

<section class="home-categories">

    <a href="#" class="category-box yugioh">

        <div class="category-logo">
            Yu-Gi-Oh!
        </div>

        <span>
            Yu-Gi-Oh!
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>


    <a href="#" class="category-box pokemon">

        <div class="category-logo">
            Pokémon
        </div>

        <span>
            Pokémon
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>


    <a href="#" class="category-box magic">

        <div class="category-logo">
            MAGIC
        </div>

        <span>
            Magic
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>


    <a href="#" class="category-box others">

        <div class="category-logo">
            <i class="bi bi-stack"></i>
        </div>

        <span>
            Otros
        </span>

        <i class="bi bi-arrow-right"></i>

    </a>

</section>


<!-- =====================================================
     PRODUCTOS DESTACADOS
     ===================================================== -->

<section class="featured-products">

    <div class="section-heading">

        <h2>
            <i class="bi bi-star-fill"></i>
            Productos destacados
        </h2>

        <a asp-controller="Categorias"
           asp-action="Index">

            Ver todos los productos
            <i class="bi bi-arrow-right"></i>

        </a>

    </div>


    <div class="featured-grid">


        <!-- PRODUCTO 1 -->

        <article class="featured-card">

            <button class="favorite">
                <i class="bi bi-heart"></i>
            </button>

            <div class="product-image">

                <img src="~/Imagenes/imagen1.jpg"
                     alt="Blue-Eyes White Dragon" />

            </div>

            <div class="product-info">

                <span class="product-game yugioh-tag">
                    Yu-Gi-Oh!
                </span>

                <h3>
                    Blue-Eyes White Dragon
                </h3>

                <span class="product-rarity">
                    Ultra Rara
                </span>

                <strong class="product-price">
                    Bs 320
                </strong>

                <button class="add-cart">
                    <i class="bi bi-cart3"></i>
                    Agregar al carrito
                </button>

            </div>

        </article>


        <!-- PRODUCTO 2 -->

        <article class="featured-card">

            <button class="favorite">
                <i class="bi bi-heart"></i>
            </button>

