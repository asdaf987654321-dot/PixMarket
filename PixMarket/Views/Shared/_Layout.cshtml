<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title class=" text-principal">@ViewData["Title"] - PixMarket</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PixMarket.styles.css" asp-append-version="true" />


</head>

<body class=" fondo">
    <header >
        <nav class=" navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
            <div class="container-fluid color-principal">
                <a class="navbar-brand text-principal" asp-area="" asp-controller="Home" asp-action="Index">PixMarket</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-principal" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-principal" asp-area="" asp-controller="Cliente" asp-action="Catalogo">Pokemon</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-principal" asp-area="" asp-controller="Cliente" asp-action="Catalogo">Yugioh</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-principal" asp-area="" asp-controller="Cliente" asp-action="Catalogo">Magic</a>
                        </li>
                        
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Usuarios" asp-action="Index">Iniciar Sesion</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="color-principal border-top footer nabar-light">
        <div class="container color-principal">
            &copy; 2026 - PixMarket - <a class=" text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
