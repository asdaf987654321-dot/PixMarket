@model PixMarket.Servicios.ApiInventarioStats
@{
    ViewData["Title"] = "Inventario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Inventario</h1>
                    <p>Controla el stock de tus cartas y productos.</p>
                </div>
                <div class="admin-fecha">
                    <i class="bi bi-boxes"></i>
                    <div>
                        <strong>Movimientos del almacén</strong>
                        <small>Actualizado hoy</small>
                    </div>
                </div>
            </div>

            <div class="admin-stats">

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Productos activos</span>
                        <strong>@Model.ProductosActivos</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Stock bajo</span>
                        <strong>@Model.StockBajo</strong>
                    </div>
                </div>

                <div class="admin-stat-card red">
                    <div class="admin-stat-icon">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Agotados</span>
                        <strong>@Model.Agotados</strong>
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Valor del inventario</span>
                        <strong>Bs @Model.ValorInventario.ToString("N2")</strong>
                    </div>
                </div>

            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-boxes"></i> Stock por producto</h3>
                    
                    <span>@(Model.Items != null ? Model.Items.Count : 0) producto(s)</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Carta</th>
                                <th>Juego</th>
                                <th>Categoría</th>
                                <th>Stock</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td>@item.Juego</td>
                                        <td>@item.Categoria</td>
                                        <td>@item.Stock</td>
                                        <td>
                                            @if (item.Stock == 0)
                                            {
                                                <span class="stock-badge red">Agotado</span>
                                            }
                                            else if (item.Stock <= 5)
                                            {
                                                <span class="stock-badge red">Crítico</span>
                                            }
                                            else
                                            {
                                                <span class="stock-badge">Disponible</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center">No hay productos registrados en el inventario.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>

</div>