<!DOCTYPE html>
@{
    var cartJson = Context.Session?.GetString("Carrito");
    var carritoCount = 0;
    if (!string.IsNullOrEmpty(cartJson))
    {
        try
        {
            var carrito = JsonSerializer.Deserialize<List<ItemCarrito>>(cartJson);
            carritoCount = carrito?.Sum(c => c.Cantidad) ?? 0;
        }
        catch
        {
            carritoCount = 0;
        }
    }
}
<html lang="es">
<head>
    


    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Block du Booster</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header class="main-navbar">

        <div class="navbar-inner">

            <!-- LOGO -->

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    <i class="bi bi-layers"></i>
                </div>

                <div class="brand-text">

                    <strong>
                        Block du <span>Booster</span>
                    </strong>

                    <small>
                        Cartas · Coleccionables · Comunidad
                    </small>

                </div>

            </a>


            <!-- MENÚ -->

            <nav class="main-menu">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-link-custom active">
                    Inicio
                </a>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   class="nav-link-custom">
                    Tienda
                </a>

                <a asp-controller="Categorias"
                   asp-action="Categorias"
                   class="nav-link-custom">
                    Categorías
                </a>

                <a asp-controller="Torneos"
                   asp-action="Index"
                   class="nav-link-custom">
                    Torneos
                </a>

                <a asp-controller="Contacto"
                   asp-action="Index"
                   class="nav-link-custom">
                    Contacto
                </a>

            </nav>


            <!-- BUSCADOR -->

            <form method="get"
                  asp-controller="Categorias"
                  asp-action="Index"
                  class="navbar-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="buscar"
                       value="@(Context.Request.Query["buscar"])"
                       placeholder="Buscar cartas, productos..." />

            </form>


            <!-- ICONOS -->

            <div class="navbar-actions">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">

                        <a href="#"
                           class="navbar-icon dropdown-toggle"
                           data-bs-toggle="dropdown"
                           data-bs-auto-close="outside"
                           title="Mi cuenta">

                            <i class="bi bi-person-circle"></i>

                            <span class="navbar-user-name">
                                @User.Identity.Name
                            </span>

                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow">

                            <li class="dropdown-header text-muted small">
                                Hola, @User.Identity.Name
                            </li>

                            @if (User.IsInRole("Administrador"))
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Usuarios"
                                       asp-action="Administrador">
                                        <i class="bi bi-speedometer2"></i>
                                        Panel de administración
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Usuarios"
                                       asp-action="Cliente">
                                        <i class="bi bi-person"></i>
                                        Mi cuenta
                                    </a>
                                </li>
                            }

                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <form method="post"
                                      asp-controller="Usuarios"
                                      asp-action="Logout">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="dropdown-item">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>

                        </ul>

                    </div>
                }
                else
                {
                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="navbar-icon"
                       title="Iniciar sesión">
                        <i class="bi bi-person"></i>
                    </a>
                }

                <a asp-controller="Carrito"
                   asp-action="Index"
                   class="navbar-icon cart-icon">

                    <i class="bi bi-cart3"></i>

                    <span class="cart-number">
                        @carritoCount
                    </span>

                </a>

            </div>

        </div>

    </header>


    <!-- ================= CONTENIDO ================= -->

    <main>
        @RenderBody()
    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="main-footer">

        <div class="footer-feature">

            <div class="footer-feature-item">

                <div class="footer-icon">
                    <i class="bi bi-truck"></i>
                </div>

                <div>
                    <strong>Envíos seguros</strong>
                    <small>A todo el país</small>
                </div>

            </div>


            <div class="footer-feature-item">

                <div class="footer-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <strong>Pagos confiables</strong>
                    <small>Transferencia, QR y más</small>
                </div>

            </div>


            <div class="footer-feature-item">

                <div class="footer-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>
                    <strong>Comunidad activa</strong>
                    <small>Torneos y eventos</small>
                </div>

            </div>


            <div class="footer-feature-item">

                <div class="footer-icon">
                    <i class="bi bi-star"></i>
                </div>

                <div>
                    <strong>Productos originales</strong>
                    <small>Calidad garantizada</small>
                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>