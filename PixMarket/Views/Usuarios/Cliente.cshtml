@{
    ViewData["Title"] = "PixMarket";
}

<div class="categorias-page">

    <!-- ENCABEZADO DE BIENVENIDA -->
    <section class="categorias-hero">

        <div class="categorias-hero-content">

            <span class="categorias-label">
                BIENVENIDO A PIXMARKET
            </span>

            <h1>
                ¡Hola, <span>@(User.Identity?.Name ?? "cliente")</span>!
            </h1>

            <p>
                Explora nuestro catálogo de cartas coleccionables
                y encuentra tus productos favoritos.
            </p>

        </div>

    </section>


    <!-- CATEGORÍAS -->
    <section class="categorias-contenido">

        <div class="categorias-titulo">

            <span>
                CATEGORÍAS
            </span>

            <h2>
                Explora nuestros juegos
            </h2>

            <p>
                Descubre cartas, productos y colecciones
                de tus juegos favoritos.
            </p>

        </div>


        <div class="categorias-grid">

            <!-- POKÉMON -->
            <a asp-controller="Categorias"
               asp-action="Index"
               asp-route-juego="Pokémon"
               class="categoria-principal pokemon">

                <div class="categoria-imagen">
                    <img src="~/Imagenes/imagen1.jpg"
                         alt="Pokémon" />
                </div>

                <div class="categoria-info">

                    <span class="categoria-tag">
                        TCG
                    </span>

                    <h3>
                        Pokémon
                    </h3>

                    <p>
                        Pokémon ex, V, entrenadores
                        y cartas coleccionables.
                    </p>

                    <span class="categoria-boton">
                        Ver colección
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </div>

            </a>


            <!-- YU-GI-OH -->
            <a asp-controller="Categorias"
               asp-action="Index"
               asp-route-juego="Yu-Gi-Oh!"
               class="categoria-principal yugioh">

                <div class="categoria-imagen">
                    <img src="~/Imagenes/imagen2.jpg"
                         alt="Yu-Gi-Oh!" />
                </div>

                <div class="categoria-info">

                    <span class="categoria-tag">
                        TCG
                    </span>

                    <h3>
                        Yu-Gi-Oh!
                    </h3>

                    <p>
                        Monstruos, hechizos y trampas
                        para tus duelos diarios.
                    </p>

                    <span class="categoria-boton">
                        Ver colección
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </div>

            </a>


            <!-- MAGIC -->
            <a asp-controller="Categorias"
               asp-action="Index"
               asp-route-juego="Magic: The Gathering"
               class="categoria-principal magic">

                <div class="categoria-imagen">
                    <img src="~/Imagenes/banner.jpg"
                         alt="Magic The Gathering" />
                </div>

                <div class="categoria-info">

                    <span class="categoria-tag">
                        TCG
                    </span>

                    <h3>
                        Magic
                    </h3>

                    <p>
                        Criaturas, tierras, hechizos
                        y cartas especiales.
                    </p>

                    <span class="categoria-boton">
                        Ver colección
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </div>

            </a>


            <!-- OTROS -->
            <a asp-controller="Categorias"
               asp-action="Index"
               class="categoria-principal otros">

                <div class="categoria-imagen categoria-icono">
                    <i class="bi bi-collection"></i>
                </div>

                <div class="categoria-info">

                    <span class="categoria-tag">
                        COLECCIONES
                    </span>

                    <h3>
                        Otros
                    </h3>

                    <p>
                        Encuentra otras cartas y
                        productos coleccionables.
                    </p>

                    <span class="categoria-boton">
                        Ver colección
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </div>

            </a>

        </div>

    </section>


    <!-- PROMOCIÓN -->
    <section class="categorias-hero" style="margin-top: -20px;">

        <div class="categorias-hero-content" style="max-width: none; text-align: center;">

            <span class="categorias-label">
                PIXMARKET
            </span>

            <h1>
                Encuentra tu próxima carta <span>favorita</span>.
            </h1>

            <p>
                Revisa nuestro catálogo completo y descubre
                diferentes productos para jugadores y coleccionistas.
            </p>

            <a asp-controller="Categorias"
               asp-action="Index"
               class="btn btn-success px-4 mt-3"
               style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; border-radius: 8px; font-weight: 700;">
                <i class="bi bi-shop me-2"></i>
                Ver catálogo completo
            </a>

        </div>

    </section>

</div>