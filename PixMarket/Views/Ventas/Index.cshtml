@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Ventas</h1>
                    <p>Consulta el historial de ventas de tu tienda.</p>
                </div>
                <a class="btn btn-success" style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; height: fit-content;">
                    <i class="bi bi-plus-circle"></i> Nueva venta
                </a>
            </div>

            <div class="admin-stats">

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas del día</span>
                        <strong>Bs 156</strong>
                    </div>
                </div>

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas de la semana</span>
                        <strong>Bs 980</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Pedidos en el mes</span>
                        <strong>47</strong>
                    </div>
                </div>

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ticket promedio</span>
                        <strong>Bs 38</strong>
                    </div>
                </div>

            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-cart-check"></i> Ventas recientes</h3>
                    <span>Últimos 30 días</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th># Venta</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Productos</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#0012</td>
                                <td>22/09/2026</td>
                                <td>Marcelo López</td>
                                <td>3</td>
                                <td>Bs 45,50</td>
                                <td><span class="estado completado">Completada</span></td>
                            </tr>
                            <tr>
                                <td>#0011</td>
                                <td>22/09/2026</td>
                                <td>Ana Rojas</td>
                                <td>1</td>
                                <td>Bs 12,50</td>
                                <td><span class="estado completado">Completada</span></td>
                            </tr>
                            <tr>
                                <td>#0010</td>
                                <td>21/09/2026</td>
                                <td>Diego Fuentes</td>
                                <td>2</td>
                                <td>Bs 76,00</td>
                                <td><span class="estado pendiente">Pendiente</span></td>
                            </tr>
                            <tr>
                                <td>#0009</td>
                                <td>20/09/2026</td>
                                <td>Camila Méndez</td>
                                <td>1</td>
                                <td>Bs 18,00</td>
                                <td><span class="estado completado">Completada</span></td>
                            </tr>
                            <tr>
                                <td>#0008</td>
                                <td>19/09/2026</td>
                                <td>Luis Torrico</td>
                                <td>4</td>
                                <td>Bs 132,00</td>
                                <td><span class="estado cancelado">Cancelada</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>

</div>