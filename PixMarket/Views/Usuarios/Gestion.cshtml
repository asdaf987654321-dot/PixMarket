@model List<PixMarket.Servicios.UsuarioDto>

@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Usuarios</h1>
                    <p>Administra las cuentas de clientes y del sistema.</p>
                </div>
                <a asp-controller="Usuarios" asp-action="Crear" class="btn btn-success" style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; height: fit-content;">
                    <i class="bi bi-person-plus"></i> Nuevo usuario
                </a>
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="admin-stats">

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Usuarios totales</span>
                        <strong>@Model.Count</strong>
                    </div>
                </div>

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Clientes activos</span>
                        <strong>@Model.Count(u => u.Estado == "Activo")</strong>
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-toggle-on"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Administradores</span>
                        <strong>@Model.Count(u => u.Rol == "Administrador")</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-person-dash"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Suspendidos</span>
                        <strong>@Model.Count(u => u.Estado == "Suspendido")</strong>
                    </div>
                </div>

            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-people"></i> Cuentas registradas</h3>
                    <span>@Model.Count usuario(s)</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" style="text-align: center; color: #94a3b8; padding: 24px;">
                                        No hay usuarios registrados por ahora.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var usuario in Model)
                                {
                                    <tr>
                                        <td>@usuario.Nombre</td>
                                        <td>@usuario.Correo</td>
                                        <td>@usuario.Rol</td>
                                        <td>@usuario.Telefono</td>
                                        <td>
                                            <span class="estado @(usuario.Estado == "Activo" ? "completado" : "pendiente")">
                                                @usuario.Estado
                                            </span>
                                        </td>

                                        <td style="text-align: right; white-space: nowrap;">
                                            <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-info" title="Ver">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form method="post" asp-action="CambiarEstado" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@usuario.Id" />
                                                <input type="hidden" name="estado"
                                                       value="@(usuario.Estado == "Activo" ? "Suspendido" : "Activo")" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                                        title="@(usuario.Estado == "Activo" ? "Suspender" : "Activar")">
                                                    <i class="bi bi-person-dash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>

</div>