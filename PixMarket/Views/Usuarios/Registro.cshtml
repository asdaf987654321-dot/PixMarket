@{
    ViewData["Title"] = "Crear Cuenta";
}

<section class="registro-page">

    <div class="registro-container">


        <!-- ================= IZQUIERDA ================= -->

        <div class="registro-presentacion">

            <div>

                <div class="registro-logo">
                    PIX<span>MARKET</span>
                </div>

                <span class="registro-etiqueta">
                    TIENDA DE CARTAS COLECCIONABLES
                </span>

                <h1>
                    Únete a nuestra comunidad
                </h1>

                <p>
                    Crea tu cuenta y disfruta de productos,
                    torneos y colecciones de cartas.
                </p>

            </div>

        </div>


        <!-- ================= FORMULARIO ================= -->

        <div class="registro-formulario">

            <div class="registro-formulario-contenido">

                <span class="seccion-etiqueta">
                    NUEVA CUENTA
                </span>

                <h2>
                    Crear una cuenta
                </h2>

                <p class="registro-subtitulo">
                    Completa tus datos para registrarte.
                </p>


                @if (ViewBag.Error != null)
                {
                    <div class="login-error">

                        <i class="bi bi-exclamation-circle"></i>

                        @ViewBag.Error

                    </div>
                }


                <form method="post"
                      asp-controller="Usuarios"
                      asp-action="Registro">


                    @Html.AntiForgeryToken()


                    <!-- NOMBRE -->

                    <div class="registro-campo">

                        <label for="nombre">
                            Nombre
                        </label>

                        <input type="text"
                               id="nombre"
                               name="nombre"
                               placeholder="Ingrese su nombre"
                               required />

                    </div>


                    <!-- CORREO -->

                    <div class="registro-campo">

                        <label for="correo">
                            Correo electrónico
                        </label>

                        <input type="email"
                               id="correo"
                               name="correo"
                               placeholder="Ingrese su correo"
                               required />

                    </div>


                    <!-- TELEFONO -->

                    <div class="registro-campo">

                        <label for="telefono">
                            Teléfono
                        </label>

                        <input type="tel"
                               id="telefono"
                               name="telefono"
                               placeholder="Ingrese su número"
                               inputmode="numeric"
                               pattern="[0-9]+"
                               required />

                    </div>


                    <!-- CONTRASEÑA -->

                    <div class="registro-campo">

                        <label for="contrasenia">
                            Contraseña
                        </label>

                        <input type="password"
                               id="contrasenia"
                               name="contrasenia"
                               placeholder="Mínimo 6 caracteres"
                               minlength="6"
                               required />

                    </div>


                    <!-- BOTÓN -->

                    <button type="submit"
                            class="registro-boton">

                        Crear cuenta

                        <i class="bi bi-arrow-right"></i>

                    </button>

                </form>


                <!-- LOGIN -->

                <div class="registro-login">

                    <span>
                        ¿Ya tienes una cuenta?
                    </span>

                    <a asp-controller="Usuarios"
                       asp-action="Index">

                        Iniciar sesión

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>