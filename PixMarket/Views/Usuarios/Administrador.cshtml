@{
    ViewData["Title"] = "Panel de Administración";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <aside class="admin-sidebar">

        <div class="admin-sidebar-brand">
            <div class="admin-brand-icon">
                <i class="bi bi-layers"></i>
            </div>
            <div class="admin-brand-text">
                <strong>Block du <span>Booster</span></strong>
                <small>Cartas · Coleccionables · Comunidad</small>
            </div>
        </div>

        <nav class="admin-menu">

            <a asp-controller="Usuarios"
               asp-action="Administrador"
               class="admin-menu-link active">
                <i class="bi bi-house-door"></i>
                <span>Inicio</span>
            </a>

            <a asp-controller="Items" asp-action="Index" class="admin-menu-link">
                <i class="bi bi-box-seam"></i>
                <span>Productos</span>
            </a>

            <a asp-controller="Inventario" asp-action="Index" class="admin-menu-link">
                <i class="bi bi-boxes"></i>
                <span>Inventario</span>
            </a>

            <a asp-controller="Ventas" asp-action="Index" class="admin-menu-link">
                <i class="bi bi-cart-check"></i>
                <span>Ventas</span>
            </a>

            <a asp-controller="Pedidos" asp-action="Index" class="admin-menu-link">
                <i class="bi bi-clipboard-check"></i>
                <span>Pedidos</span>
            </a>

            <a asp-controller="Usuarios" asp-action="Gestion" class="admin-menu-link">
                <i class="bi bi-people"></i>
                <span>Usuarios</span>
            </a>

            <a asp-controller="Reportes" asp-action="Index" class="admin-menu-link">
                <i class="bi bi-bar-chart"></i>
                <span>Reportes</span>
            </a>

            <a asp-controller="Configuracion" asp-action="Index" class="admin-menu-link">
                <i class="bi bi-gear"></i>
                <span>Configuración</span>
            </a>

        </nav>

        <div class="admin-sidebar-footer">
            <img src="~/Imagenes/banner.jpg" alt="Block du Booster" />
            <p>¡Más que cartas,<br />una pasión!</p>
        </div>

    </aside>


    <main class="admin-main">

        
        <header class="admin-topbar">

            <div class="admin-search-container" style="position: relative; width: 350px;">
                <form class="admin-search" onsubmit="return false;" style="width: 100%; margin: 0;">
                    <i class="bi bi-search"></i>
                    <input type="text" id="inputBusquedaAdmin" placeholder="Buscar productos, usuarios, pedidos..." autocomplete="off" style="width: 100%;" />
                </form>

                
                <div id="resultadosBusquedaDropdown" class="dropdown-menu shadow w-100" style="display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 1050; max-height: 350px; overflow-y: auto;">
                    
                </div>
            </div>

            <div class="admin-topbar-actions">

                <div class="dropdown">
                    <a href="#"
                       class="admin-user"
                       data-bs-toggle="dropdown"
                       data-bs-auto-close="outside"
                       title="Mi cuenta">
                        <div class="admin-user-avatar">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="admin-user-info">
                            <strong>@(User.Identity?.Name ?? "Admin")</strong>
                            <small>Administrador</small>
                        </div>
                        <i class="bi bi-chevron-down"></i>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li class="dropdown-header text-muted small">
                            Hola, @(User.Identity?.Name ?? "Admin")
                        </li>

                        <li>
                            <a class="dropdown-item"
                               asp-controller="Categorias"
                               asp-action="Index">
                                <i class="bi bi-shop"></i>
                                Ver tienda
                            </a>
                        </li>

                        <li><hr class="dropdown-divider" /></li>

                        <li>
                            <form method="post"
                                  asp-controller="Usuarios"
                                  asp-action="Logout">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

            </div>

        </header>


       
        <section class="admin-content">

            
            <div class="admin-welcome">
                <div>
                    <h1>¡Hola, @(User.Identity?.Name ?? "Admin")!</h1>
                    <p>Aquí tienes un resumen de lo que está pasando en tu tienda.</p>
                </div>
                <div class="admin-fecha">
                    <i class="bi bi-calendar3"></i>
                    <div>
                        <strong>15 de septiembre de 2026</strong>
                        <small>Cochabamba, Bolivia</small>
                    </div>
                </div>
            </div>


            
            <div class="admin-stats">

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Productos</span>
                        
                        
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas del día</span>
                       
                       
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Pedidos pendientes</span>
                       
                     
                    </div>
                </div>

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Usuarios registrados</span>
                      
                      
                    </div>
                </div>

            </div>


            
            <div class="admin-grid">

                
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-bar-chart-line"></i> Ventas de los últimos 7 días</h3>
                        <select>
                            <option>Últimos 7 días</option>
                            <option>Últimos 30 días</option>
                        </select>
                    </div>
                    <div class="admin-chart-placeholder">
                        
                    </div>
                </div>


                
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-exclamation-triangle"></i> Stock bajo</h3>
                        <a asp-controller="Inventario" asp-action="Index">Ver todo →</a>
                    </div>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Carta</th>
                                <th>Categoría</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            
                        </tbody>
                    </table>
                </div>

            </div>


            
            <div class="admin-panel full-width">

                <div class="admin-panel-header">
                    <h3><i class="bi bi-clipboard-list"></i> Pedidos recientes</h3>
                    <a asp-controller="Pedidos" asp-action="Index">Ver todos →</a>
                </div>

                <table class="admin-table">
                    <thead>
                        <tr>
                            <th># Pedido</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                    </tbody>
                </table>

            </div>


            
            <div class="admin-recordatorio">
                <div class="admin-recordatorio-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <strong>¡Recuerda!</strong>
                    <p>Valida el stock físico antes de confirmar un pedido web. Así evitamos problemas y mantenemos a nuestros duelistas felices.</p>
                </div>
                <div class="admin-recordatorio-frase">
                    <em>Cartas que<br />conectan personas</em>
                </div>
            </div>

        </section>

    </main>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("inputBusquedaAdmin");
        const dropdown = document.getElementById("resultadosBusquedaDropdown");

        let timeout = null;

        input.addEventListener("input", function () {
            clearTimeout(timeout);
            const query = input.value.trim();

            if (query.length < 2) {
                dropdown.style.display = "none";
                dropdown.innerHTML = "";
                return;
            }

            
            timeout = setTimeout(() => {
                fetch(`/Reportes/BuscarJson?q=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(data => {
                        dropdown.innerHTML = "";

                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const a = document.createElement("a");
                                a.className = "dropdown-item d-flex justify-content-between align-items-center py-2";
                                a.href = item.url;
                                a.innerHTML = `
                                    <div>
                                        <strong class="text-dark">${item.nombre}</strong>
                                        <span class="badge bg-secondary ms-2" style="font-size: 0.75rem;">${item.tipo}</span>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted small"></i>
                                `;
                                dropdown.appendChild(a);
                            });
                            dropdown.style.display = "block";
                        } else {
                            dropdown.innerHTML = `<span class="dropdown-item text-muted text-center py-2">No se encontraron resultados</span>`;
                            dropdown.style.display = "block";
                        }
                    })
                    .catch(err => {
                        console.error("Error en la búsqueda:", err);
                        dropdown.style.display = "none";
                    });
            }, 300);
        });

        
        document.addEventListener("click", function (e) {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = "none";
            }
        });

        
        input.addEventListener("focus", function () {
            if (input.value.trim().length >= 2 && dropdown.children.length > 0) {
                dropdown.style.display = "block";
            }
        });
    });
</script>