@using PixMarket.Servicios
@inject IPixMarketApiService Api

@{
    // Notificaciones activas
    var notificaciones = new List<(string Icono, string Color, string Mensaje)>();

    try
    {
        var config = await Api.ObtenerConfiguracionAsync();

        // Notificación 1: Stock bajo
        if (config.NotificarStockBajo)
        {
            var inventario = await Api.ObtenerEstadisticasInventarioAsync();
            if (inventario != null && inventario.StockBajo > 0)
            {
                notificaciones.Add((
                    "bi-exclamation-triangle-fill",
                    "text-warning",
                    $"{inventario.StockBajo} carta(s) con stock bajo"
                ));
            }
        }

        // Notificación 2: Pedidos pendientes
        if (config.AvisosNuevosPedidos)
        {
            var pedidos = await Api.ObtenerPedidosAdminAsync();
            if (pedidos != null)
            {
                var pendientes = pedidos.Count(p => p.Estado == "Pendiente");
                if (pendientes > 0)
                {
                    notificaciones.Add((
                        "bi-clipboard-check-fill",
                        "text-info",
                        $"{pendientes} pedido(s) pendiente(s)"
                    ));
                }
            }
        }

        
    }
    catch (HttpRequestException)
    {
        // Sin notificaciones si la API falla
    }
}

<header class="admin-topbar">

    <!-- ============ BUSCADOR ============ -->
    <div class="admin-search-container" style="position: relative; width: 350px;">
        <form class="admin-search" onsubmit="return false;" style="width: 100%; margin: 0;">
            <i class="bi bi-search"></i>
            <input type="text" id="inputBusquedaAdmin" placeholder="Buscar productos, usuarios, pedidos..." autocomplete="off" style="width: 100%;" />
        </form>


        <div id="resultadosBusquedaDropdown" class="dropdown-menu shadow w-100" style="display: none; position: absolute; top: 100%; left: 0; right: 0; z-index: 1050; max-height: 350px; overflow-y: auto;">
        </div>

    </div>



    <!-- ============ ACCIONES (CAMPANITA + USUARIO) ============ -->
    <div class="admin-topbar-actions">

        <!--  CAMPANITA DE NOTIFICACIONES -->
        <div class="dropdown">
            <button class="admin-icon-btn"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    title="Notificaciones">
                <i class="bi bi-bell"></i>
                @if (notificaciones.Any())
                {
                    <span class="admin-badge">@notificaciones.Count</span>
                }
            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow" style="min-width: 320px;">

                <li class="dropdown-header">
                    <strong>Notificaciones</strong>
                </li>

                @if (!notificaciones.Any())
                {
                    <li class="text-center text-muted p-4">
                        <i class="bi bi-bell-slash" style="font-size: 1.8rem;"></i>
                        <p class="mb-0 mt-2">Sin notificaciones</p>
                    </li>
                }
                else
                {
                    @foreach (var noti in notificaciones)
                    {
                        <li>
                            <a class="dropdown-item d-flex align-items-start gap-2 py-2" href="#">
                                <i class="bi @noti.Icono @noti.Color" style="font-size: 1.2rem; margin-top: 2px;"></i>
                                <span>@noti.Mensaje</span>
                            </a>
                        </li>
                    }
                }

            </ul>
        </div>

        <!--  USUARIO -->
        <div class="dropdown">
            <a href="#"
               class="admin-user"
               data-bs-toggle="dropdown"
               data-bs-auto-close="outside"
               title="Mi cuenta">
                <div class="admin-user-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div class="admin-user-info">
                    <strong>@(User.Identity?.Name ?? "Admin")</strong>
                    <small>Administrador</small>
                </div>
                <i class="bi bi-chevron-down"></i>
            </a>

            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li class="dropdown-header text-muted small">
                    Hola, @(User.Identity?.Name ?? "Admin")
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="Categorias" asp-action="Index">
                        <i class="bi bi-shop"></i> Ver tienda
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form method="post" asp-controller="Usuarios" asp-action="Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                        </button>
                    </form>
                </li>
            </ul>
        </div>

    </div>

</header>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("inputBusquedaAdmin");
        const dropdown = document.getElementById("resultadosBusquedaDropdown");

        let timeout = null;

        input.addEventListener("input", function () {
            clearTimeout(timeout);
            const query = input.value.trim();

            if (query.length < 2) {
                dropdown.style.display = "none";
                dropdown.innerHTML = "";
                return;
            }


            timeout = setTimeout(() => {
                fetch(`/Reportes/BuscarJson?q=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(data => {
                        dropdown.innerHTML = "";

                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const a = document.createElement("a");
                                a.className = "dropdown-item d-flex justify-content-between align-items-center py-2";
                                a.href = item.url;
                                a.innerHTML = `
                                    <div>
                                        <strong class="text-dark">${item.nombre}</strong>
                                        <span class="badge bg-secondary ms-2" style="font-size: 0.75rem;">${item.tipo}</span>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted small"></i>
                                `;
                                dropdown.appendChild(a);
                            });
                            dropdown.style.display = "block";
                        } else {
                            dropdown.innerHTML = `<span class="dropdown-item text-muted text-center py-2">No se encontraron resultados</span>`;
                            dropdown.style.display = "block";
                        }
                    })
                    .catch(err => {
                        console.error("Error en la búsqueda:", err);
                        dropdown.style.display = "none";
                    });
            }, 300);
        });


        document.addEventListener("click", function (e) {
            if (!input.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = "none";
            }
        });


        input.addEventListener("focus", function () {
            if (input.value.trim().length >= 2 && dropdown.children.length > 0) {
                dropdown.style.display = "block";
            }
        });
    });
</script>