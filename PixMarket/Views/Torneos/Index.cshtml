@{
    ViewData["Title"] = "Torneos";
}

<div class="torneos-layout">

    <!-- ================= SIDEBAR ================= -->

    <aside class="torneos-sidebar">

        <div class="torneos-sidebar-menu">

            <a asp-controller="Home"
               asp-action="Index"
               class="torneo-side-link">

                <i class="bi bi-house-fill"></i>
                <span>Inicio</span>

            </a>

            <a asp-controller="Categorias"
               asp-action="Index"
               class="torneo-side-link">

                <i class="bi bi-cart3"></i>
                <span>Tienda</span>

            </a>

            <a asp-controller="Categorias"
               asp-action="Index"
               class="torneo-side-link">

                <i class="bi bi-grid-fill"></i>
                <span>Categorías</span>

            </a>

            <a href="#"
               class="torneo-side-link">

                <i class="bi bi-tag-fill"></i>
                <span>Ofertas</span>

            </a>

            <div class="torneo-side-separator"></div>

            <a asp-controller="Torneos"
               asp-action="Index"
               class="torneo-side-link active">

                <i class="bi bi-trophy-fill"></i>
                <span>Torneos</span>

            </a>

            <a asp-controller="Usuarios"
               asp-action="Index"
               class="torneo-side-link">

                <i class="bi bi-people-fill"></i>
                <span>Mi cuenta</span>

            </a>

            <a asp-controller="Usuarios"
               asp-action="Index"
               class="torneo-side-link">

                <i class="bi bi-person"></i>
                <span>Perfil</span>

            </a>

        </div>


        <div class="torneo-sidebar-frase">

            <i class="bi bi-trophy-fill"></i>

            <p>
                ¡Demuestra<br />
                tus habilidades,<br />
                vive la<br />
                experiencia!
            </p>

        </div>

    </aside>


    <!-- ================= CONTENIDO ================= -->

    <main class="torneos-content">


        <!-- ================= HERO ================= -->

        <section class="torneos-banner">

            <div class="torneos-banner-texto">

                <h1>
                    Torneos de
                    <span>cartas</span>
                </h1>

                <h2>
                    ¡Compite, gana y colecciona!
                </h2>

                <p>
                    Participa en nuestros torneos oficiales y
                    demuestra que eres el mejor duelista de
                    Cochabamba.
                </p>

                <div class="torneos-beneficios">

                    <div>
                        <i class="bi bi-trophy"></i>

                        <span>
                            Premios<br />
                            exclusivos
                        </span>
                    </div>

                    <div>
                        <i class="bi bi-people-fill"></i>

                        <span>
                            Comunidad<br />
                            de duelistas
                        </span>
                    </div>

                    <div>
                        <i class="bi bi-shield-check"></i>

                        <span>
                            Ambiente seguro<br />
                            y competitivo
                        </span>
                    </div>

                </div>

            </div>


            <div class="torneos-banner-imagen">

                <img src="~/Imagenes/banner.jpg"
                     alt="Torneos PixMarket" />

            </div>

        </section>


        <!-- ================= FILTROS ================= -->

        <section class="torneos-filtros">

            <a href="#"
               class="torneo-filtro active">

                <i class="bi bi-grid-fill"></i>

                <span>Todos</span>

            </a>

            <a href="#"
               class="torneo-filtro">

                <span class="filtro-logo yugioh">
                    YU
                </span>

                <span>Yu-Gi-Oh!</span>

            </a>

            <a href="#"
               class="torneo-filtro">

                <span class="filtro-logo pokemon">
                    P
                </span>

                <span>Pokémon</span>

            </a>

            <a href="#"
               class="torneo-filtro">

                <span class="filtro-logo magic">
                    M
                </span>

                <span>Magic</span>

            </a>

            <a href="#"
               class="torneo-filtro">

                <i class="bi bi-stack"></i>

                <span>Otros</span>

            </a>


            <div class="torneo-ordenar">

                <i class="bi bi-calendar3"></i>

                <span>
                    Ordenar por:<br />
                    <strong>Próximos torneos</strong>
                </span>

                <i class="bi bi-chevron-down"></i>

            </div>

        </section>


        <!-- ================= CUERPO ================= -->

        <div class="torneos-cuerpo">


            <!-- ================= TARJETAS ================= -->

            <section class="torneos-lista">


                <!-- TORNEO 1 -->

                <article class="torneo-item">

                    <div class="torneo-imagen">

                        <img src="~/Imagenes/banner.jpg"
                             alt="Torneo Regional Yu-Gi-Oh!" />

                        <span class="torneo-badge">
                            Oficial
                        </span>

                    </div>

                    <div class="torneo-info">

                        <h3>
                            Torneo Regional Yu-Gi-Oh!
                        </h3>

                        <p>
                            <i class="bi bi-calendar3"></i>
                            28 de septiembre de 2026
                        </p>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            Block du Booster - Cochabamba
                        </p>

                        <p>
                            <i class="bi bi-trophy"></i>
                            Formato: Advanced (BO3)
                        </p>

                        <div class="torneo-card-footer">

                            <a asp-controller="Torneos"
                               asp-action="Inscribirse"
                               asp-route-id="1"
                               class="btn-inscripcion">

                                Inscribirse

                                <i class="bi bi-arrow-right"></i>

                            </a>

                            <span class="cupos">
                                <i class="bi bi-people-fill"></i>
                                24/64
                            </span>

                        </div>

                    </div>

                </article>


                <!-- TORNEO 2 -->

                <article class="torneo-item">

                    <div class="torneo-imagen">

                        <img src="~/Imagenes/imagen2.jpg"
                             alt="Torneo Pokémon TCG" />

                        <span class="torneo-badge">
                            Oficial
                        </span>

                    </div>

                    <div class="torneo-info">

                        <h3>
                            Torneo Pokémon TCG
                        </h3>

                        <p>
                            <i class="bi bi-calendar3"></i>
                            4 de octubre de 2026
                        </p>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            Block du Booster - Cochabamba
                        </p>

                        <p>
                            <i class="bi bi-trophy"></i>
                            Formato: Estándar (BO3)
                        </p>

                        <div class="torneo-card-footer">

                            <a asp-controller="Torneos"
                               asp-action="Inscribirse"
                               asp-route-id="2"
                               class="btn-inscripcion">

                                Inscribirse

                                <i class="bi bi-arrow-right"></i>

                            </a>

                            <span class="cupos">
                                <i class="bi bi-people-fill"></i>
                                32/64
                            </span>

                        </div>

                    </div>

                </article>


                <!-- TORNEO 3 -->

                <article class="torneo-item">

                    <div class="torneo-imagen">

                        <img src="~/Imagenes/banner.jpg"
                             alt="Torneo Magic" />

                        <span class="torneo-badge">
                            Oficial
                        </span>

                    </div>

                    <div class="torneo-info">

                        <h3>
                            Torneo Magic: The Gathering
                        </h3>

                        <p>
                            <i class="bi bi-calendar3"></i>
                            11 de octubre de 2026
                        </p>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            Block du Booster - Cochabamba
                        </p>

                        <p>
                            <i class="bi bi-trophy"></i>
                            Formato: Commander (EDH)
                        </p>

                        <div class="torneo-card-footer">

                            <a asp-controller="Torneos"
                               asp-action="Inscribirse"
                               asp-route-id="3"
                               class="btn-inscripcion">

                                Inscribirse

                                <i class="bi bi-arrow-right"></i>

                            </a>

                            <span class="cupos">
                                <i class="bi bi-people-fill"></i>
                                18/32
                            </span>

                        </div>

                    </div>

                </article>


                <!-- TORNEO 4 -->

                <article class="torneo-item">

                    <div class="torneo-imagen">

                        <img src="~/Imagenes/imagen1.jpg"
                             alt="Torneo Local Yu-Gi-Oh!" />

                        <span class="torneo-badge local">
                            Local
                        </span>

                    </div>

                    <div class="torneo-info">

                        <h3>
                            Torneo Local Yu-Gi-Oh!
                        </h3>

                        <p>
                            <i class="bi bi-calendar3"></i>
                            18 de octubre de 2026
                        </p>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            Block du Booster - Cochabamba
                        </p>

                        <p>
                            <i class="bi bi-trophy"></i>
                            Formato: Casual (BO1)
                        </p>

                        <div class="torneo-card-footer">

                            <a asp-controller="Torneos"
                               asp-action="Inscribirse"
                               asp-route-id="4"
                               class="btn-inscripcion">

                                Inscribirse

                                <i class="bi bi-arrow-right"></i>

                            </a>

                            <span class="cupos">
                                <i class="bi bi-people-fill"></i>
                                12/32
                            </span>

                        </div>

                    </div>

                </article>


                <!-- TORNEO 5 -->

                <article class="torneo-item">

                    <div class="torneo-imagen">

                        <img src="~/Imagenes/imagen2.jpg"
                             alt="Liga Pokémon" />

                        <span class="torneo-badge liga">
                            Liga
                        </span>

                    </div>

                    <div class="torneo-info">

                        <h3>
                            Liga Pokémon - Octubre
                        </h3>

                        <p>
                            <i class="bi bi-calendar3"></i>
                            25 de octubre de 2026
                        </p>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            Block du Booster - Cochabamba
                        </p>

                        <p>
                            <i class="bi bi-trophy"></i>
                            Formato: Estándar (BO3)
                        </p>

                        <div class="torneo-card-footer">

                            <a asp-controller="Torneos"
                               asp-action="Inscribirse"
                               asp-route-id="5"
                               class="btn-inscripcion">

                                Inscribirse

                                <i class="bi bi-arrow-right"></i>

                            </a>

                            <span class="cupos">
                                <i class="bi bi-people-fill"></i>
                                20/32
                            </span>

                        </div>

                    </div>

                </article>


                <!-- TORNEO 6 -->

                <article class="torneo-item">

                    <div class="torneo-imagen">

                        <img src="~/Imagenes/banner.jpg"
                             alt="Torneo Magic" />

                        <span class="torneo-badge principiante">
                            Principiante
                        </span>

                    </div>

                    <div class="torneo-info">

                        <h3>
                            Torneo de iniciación Magic
                        </h3>

                        <p>
                            <i class="bi bi-calendar3"></i>
                            1 de noviembre de 2026
                        </p>

                        <p>
                            <i class="bi bi-geo-alt"></i>
                            Block du Booster - Cochabamba
                        </p>

                        <p>
                            <i class="bi bi-trophy"></i>
                            Formato: Commander (EDH)
                        </p>

                        <div class="torneo-card-footer">

                            <a asp-controller="Torneos"
                               asp-action="Inscribirse"
                               asp-route-id="6"
                               class="btn-inscripcion">

                                Inscribirse

                                <i class="bi bi-arrow-right"></i>

                            </a>

                            <span class="cupos">
                                <i class="bi bi-people-fill"></i>
                                10/16
                            </span>

                        </div>

                    </div>

                </article>

            </section>


            <!-- ================= COLUMNA DERECHA ================= -->

            <aside class="torneos-derecha">


                <!-- PRÓXIMOS -->

                <div class="proximos-box">

                    <div class="proximos-titulo">

                        <i class="bi bi-calendar-event"></i>

                        <h3>
                            Próximos torneos
                        </h3>

                    </div>


                    <a href="#" class="proximo-item">

                        <div class="fecha-torneo">
                            <strong>28</strong>
                            <span>Sep</span>
                        </div>

                        <div>
                            <strong>
                                Torneo Regional Yu-Gi-Oh!
                            </strong>

                            <small>
                                Formato Advanced (BO3)
                            </small>
                        </div>

                        <i class="bi bi-chevron-right"></i>

                    </a>


                    <a href="#" class="proximo-item">

                        <div class="fecha-torneo">
                            <strong>04</strong>
                            <span>Oct</span>
                        </div>

                        <div>
                            <strong>
                                Torneo Pokémon TCG
                            </strong>

                            <small>
                                Formato Estándar (BO3)
                            </small>
                        </div>

                        <i class="bi bi-chevron-right"></i>

                    </a>


                    <a href="#" class="proximo-item">

                        <div class="fecha-torneo">
                            <strong>11</strong>
                            <span>Oct</span>
                        </div>

                        <div>
                            <strong>
                                Torneo Magic: The Gathering
                            </strong>

                            <small>
                                Formato Commander (EDH)
                            </small>
                        </div>

                        <i class="bi bi-chevron-right"></i>

                    </a>


                    <a href="#" class="proximo-item">

                        <div class="fecha-torneo">
                            <strong>18</strong>
                            <span>Oct</span>
                        </div>

                        <div>
                            <strong>
                                Torneo Local Yu-Gi-Oh!
                            </strong>

                            <small>
                                Formato Casual (BO1)
                            </small>
                        </div>

                        <i class="bi bi-chevron-right"></i>

                    </a>


                    <a href="#" class="calendario-link">

                        Ver calendario completo

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>


                <!-- ORGANIZAR -->

                <div class="organizar-box">

                    <i class="bi bi-trophy"></i>

                    <h3>
                        ¿Quieres organizar un torneo?
                    </h3>

                    <p>
                        Contáctanos y te ayudamos a hacerlo
                        realidad. ¡En Block du Booster hacemos
                        crecer la comunidad!
                    </p>

                    <a href="#">
                        Contactar
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <!-- BANNER FINAL -->

                <div class="torneo-final-imagen">

                    <img src="~/Imagenes/banner.jpg"
                         alt="Comunidad PixMarket" />

                    <div>
                        ¡Nos vemos<br />
                        en el próximo<br />
                        torneo!
                    </div>

                </div>

            </aside>

        </div>

    </main>

</div>