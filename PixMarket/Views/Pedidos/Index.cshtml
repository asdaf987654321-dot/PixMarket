@model IEnumerable<PixMarket.Servicios.VentaDto>
@{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="admin-welcome">
                <div>
                    <h1>Pedidos</h1>
                    <p>Revisa y gestiona los pedidos de tus clientes.</p>
                </div>
                <div class="admin-fecha">
                    <i class="bi bi-clipboard-check"></i>
                    <div>
                        <strong>Estado del flujo de pedidos</strong>
                        <small>Actualizado hoy</small>
                    </div>
                </div>
            </div>

            
            <div class="admin-stats">
                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon"><i class="bi bi-hourglass-split"></i></div>
                    <div class="admin-stat-info">
                        <span>Pendientes</span>
                        <strong>@(Model?.Count(p => p.Estado == "Pendiente") ?? 0)</strong>
                    </div>
                </div>

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon"><i class="bi bi-box"></i></div>
                    <div class="admin-stat-info">
                        <span>En preparación</span>
                        <strong>@(Model?.Count(p => p.Estado == "En Preparacion") ?? 0)</strong>
                    </div>
                </div>

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon"><i class="bi bi-truck"></i></div>
                    <div class="admin-stat-info">
                        <span>En camino</span>
                        <strong>@(Model?.Count(p => p.Estado == "En Camino") ?? 0)</strong>
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon"><i class="bi bi-check-circle"></i></div>
                    <div class="admin-stat-info">
                        <span>Entregados</span>
                        <strong>@(Model?.Count(p => p.Estado == "Entregado") ?? 0)</strong>
                    </div>
                </div>
            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-clipboard-list"></i> Lista de pedidos</h3>
                    <span>@(Model?.Count() ?? 0) pedido(s) registrado(s)</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th># Pedido</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            
                        {
                                @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.Id.ToString("D4")</td>
                                    <td>@item.NombreUsuario</td>
                                    <td>Bs @item.Total.ToString("N2")</td>
                                    <td>
                                        <span class="estado @(item.Estado?.ToLower().Replace(" ", ""))">
                                            @item.Estado
                                        </span>
                                    </td>
                                    <td>@item.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td style="text-align: right; white-space: nowrap;">
                                        
                                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver Detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Cambiar Estado">
                                                <i class="bi bi-sliders"></i>
                                            </button>
                                            <ul class="dropdown-menu shadow">
                                                <li>
                                                    <form asp-action="CambiarEstado" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="estado" value="Pendiente" />
                                                        <button type="submit" class="dropdown-item">Pendiente</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="CambiarEstado" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="estado" value="En Preparacion" />
                                                        <button type="submit" class="dropdown-item">En Preparación</button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="CambiarEstado" method="post">
                                                        <input type="hidden" name="id" value="@item.Id" />
                                                        <input type="hidden" name="estado" value="En Camino" />
                                                        <button type="submit" class="dropdown-item">En Camino</button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>

                                        
                                        <form asp-action="CambiarEstado" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="estado" value="Entregado" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Marcar como Entregado">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            }
                            else
                            {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 2rem; color: #6c757d;">
                                    No hay pedidos registrados en el sistema.
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>
</div>