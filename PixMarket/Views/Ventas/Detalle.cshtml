@model PixMarket.Servicios.VentaDetalleDto

@{
    ViewData["Title"] = $"Detalle de la Venta #{Model?.Id}";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2>Venta #@Model?.Id</h2>
                    <p>Detalle de la venta entregada y sus productos.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver a Ventas
                </a>
            </div>

            <div class="row">

                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3">Información de la venta</h5>
                            <p class="mb-1"><strong>Cliente:</strong> @Model?.NombreUsuario</p>
                            <p class="mb-1"><strong>Fecha:</strong> @Model?.FechaVenta.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="mb-3">
                                <strong>Estado actual:</strong>
                                <span class="estado @(Model?.Estado?.ToLower().Replace(" ", ""))">
                                    @Model?.Estado
                                </span>
                            </p>

                            <hr>

                            <h5 class="card-title fw-bold mb-3">Productos</h5>
                            <p class="mb-1"><strong>Cantidad de productos:</strong> @Model?.Lineas.Count</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <h5 class="card-title fw-bold mb-3">Detalle de productos</h5>
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Item</th>
                                            <th>Cantidad</th>
                                            <th>Precio Unitario</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model?.Lineas != null)
                                        {
                                            foreach (var item in Model.Lineas)
                                            {
                                                <tr>
                                                    <td>@item.NombreItem</td>
                                                    <td>@item.Cantidad</td>
                                                    <td>Bs @item.PrecioUnitario.ToString("N2")</td>
                                                    <td class="fw-bold">Bs @item.Subtotal.ToString("N2")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-end mt-3">
                                <h4 class="fw-bold">Total: <span class="text-success">Bs @Model?.Total.ToString("N2")</span></h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver a Ventas
                </a>
            </div>

        </section>

    </main>
</div>
