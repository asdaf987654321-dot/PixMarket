@{
    ViewData["Title"] = "Panel de Administracion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-speedometer2"></i> @ViewData["Title"]</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="text-fondo color-secundario">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">ventas totales</h6>
                        <h2>contador de ventas</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="text-fondo color-principal">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">reservas</h6>
                        <h2>contador de reservas</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="error">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">stocks bajos</h6>
                        <h2>nro de stocks bajos</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class=" exito">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title">descontinuados</h6>
                        <h2>fueara del catalogo</h2>
                    </div>
                    <i class="bi bi-book" style="font-size: 2.5rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Accesos Rapidos</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <a asp-action="Productos" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-workspace"></i> administrar productos
                    </a>
                    <a asp-action="Reservas" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-badge"></i> administrar reservas
                    </a>
                    <a asp-action="Reportes" class="list-group-item list-group-item-action">
                        <i class="bi bi-person-badge"></i> reportes
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>