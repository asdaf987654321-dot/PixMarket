@{
    ViewData["Title"] = "Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Usuarios</h1>
                    <p>Administra las cuentas de clientes y del sistema.</p>
                </div>
                <a class="btn btn-success" style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; height: fit-content;">
                    <i class="bi bi-person-plus"></i> Nuevo usuario
                </a>
            </div>

            <div class="admin-stats">

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Usuarios totales</span>
                        <strong>128</strong>
                    </div>
                </div>

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-person-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Clientes activos</span>
                        <strong>114</strong>
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-toggle-on"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Administradores</span>
                        <strong>2</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-person-dash"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Suspendidos</span>
                        <strong>2</strong>
                    </div>
                </div>

            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-people"></i> Cuentas registradas</h3>
                    <span>128 usuario(s)</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Marcelo López</td>
