@{
    ViewData["Title"] = "PixMarket";
    Layout = "_Layout";
}

<!-- ENCABEZADO DE CLIENTE -->
<section class="cliente-header">

    <div>
        <span class="seccion-etiqueta">
            PIXMARKET
        </span>

        <h1>
            Bienvenido a <span>PixMarket</span>
        </h1>

        <p>
            Explora nuestro catálogo de cartas coleccionables
            y encuentra tus productos favoritos.
        </p>
    </div>

</section>


<!-- CATEGORÍAS -->
<section class="cliente-categorias">

    <div class="cliente-titulo">

        <span class="seccion-etiqueta">
            CATEGORÍAS
        </span>

        <h2>
            Explora nuestros juegos
        </h2>

    </div>


    <div class="cliente-grid">

        <!-- POKÉMON -->
        <div class="juego-card">

            <div class="juego-imagen">
                <img src="~/Imagenes/imagen1.jpg"
                     alt="Pokémon" />
            </div>

            <div class="juego-contenido">

                <span>TCG</span>

                <h3>Pokémon</h3>

                <p>
                    Descubre cartas y productos
                    relacionados con Pokémon.
                </p>

                <a href="#" class="juego-boton">
                    Ver colección
                </a>

            </div>

        </div>


        <!-- YU-GI-OH -->
        <div class="juego-card">

            <div class="juego-imagen">
                <img src="~/Imagenes/imagen2.jpg"
                     alt="Yu-Gi-Oh!" />
            </div>

            <div class="juego-contenido">

                <span>TCG</span>

                <h3>Yu-Gi-Oh!</h3>

                <p>
                    Encuentra cartas para tus
                    partidas y colecciones.
                </p>

                <a href="#" class="juego-boton">
                    Ver colección
                </a>

            </div>

        </div>


        <!-- MAGIC -->
        <div class="juego-card">

            <div class="juego-imagen">

                <img src="~/Imagenes/banner.jpg"
                     alt="Magic" />

            </div>

            <div class="juego-contenido">

                <span>TCG</span>

                <h3>Magic</h3>

                <p>
                    Explora cartas y accesorios
                    para Magic.
                </p>

                <a href="#" class="juego-boton">
                    Ver colección
                </a>

            </div>

        </div>

    </div>

</section>


<!-- PROMOCIÓN -->
<section class="cliente-promocion">

    <div>

        <span class="seccion-etiqueta">
            PIXMARKET
        </span>

        <h2>
            Encuentra tu próxima carta favorita.
        </h2>

        <p>
            Revisa nuestro catálogo y descubre
            diferentes productos para jugadores
            y coleccionistas.
        </p>

        <a href="#" class="btn-pix">
            Ver catálogo
        </a>

    </div>

</section>