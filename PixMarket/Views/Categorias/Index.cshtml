@{
    ViewData["Title"] = "Tienda";
}


<div class="store-layout">


    <!-- =================================================
         SIDEBAR
         ================================================= -->

    <aside class="store-sidebar">

        <div class="sidebar-title">
            <i class="bi bi-shop"></i>
            Tienda
        </div>


        <a class="sidebar-link active">
            <i class="bi bi-shop"></i>
            Tienda
        </a>

        <a class="sidebar-link">
            <i class="bi bi-collection"></i>
            Productos
        </a>

        <a class="sidebar-link">
            <i class="bi bi-grid"></i>
            Categorías
        </a>

        <a class="sidebar-link">
            <i class="bi bi-tag"></i>
            Ofertas
        </a>


        <div class="sidebar-separator"></div>


        <!-- FILTROS -->

        <div class="filter-title">

            <i class="bi bi-funnel"></i>

            Filtros

        </div>


        <!-- JUEGO -->

        <div class="filter-section">

            <div class="filter-heading">
                Juego

                <i class="bi bi-chevron-up"></i>
            </div>


            <label class="check-option">

                <input type="checkbox"
                       checked />

                <span></span>

                Yu-Gi-Oh!

            </label>


            <label class="check-option">

                <input type="checkbox"
                       checked />

                <span></span>

                Pokémon

            </label>


            <label class="check-option">

                <input type="checkbox"
                       checked />

                <span></span>

                Magic: The Gathering

            </label>

        </div>


        <!-- CATEGORÍA -->

        <div class="filter-section">

            <div class="filter-heading">
                Categoría

                <i class="bi bi-chevron-up"></i>
            </div>


            <label class="check-option">
                <input type="checkbox" checked />
                <span></span>
                Monstruos
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Hechizos
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Trampas
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Entrenadores
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Otros
            </label>

        </div>


        <!-- RAREZA -->

        <div class="filter-section">

            <div class="filter-heading">
                Rareza

                <i class="bi bi-chevron-up"></i>
            </div>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Common
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Uncommon
            </label>


            <label class="check-option">
                <input type="checkbox" checked />
                <span></span>
                Rare
            </label>


            <label class="check-option">
                <input type="checkbox" checked />
                <span></span>
                Super Rare
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Ultra Rare
            </label>


            <label class="check-option">
                <input type="checkbox" />
                <span></span>
                Secret Rare
            </label>

        </div>


        <!-- PRECIO -->

        <div class="filter-section">

            <div class="filter-heading">
                Rango de precio

                <i class="bi bi-chevron-up"></i>
            </div>


            <div class="price-values">

                <span>
                    Bs 0
                </span>

                <span>
                    Bs 1,000+
                </span>

            </div>


            <div class="fake-slider">

                <div class="slider-line"></div>

                <span class="slider-dot left"></span>

                <span class="slider-dot right"></span>

            </div>


            <button class="apply-filter">
                Aplicar filtros
            </button>

        </div>

    </aside>


    <!-- =================================================
         CONTENIDO
         ================================================= -->

    <main class="store-content">


        <!-- BREADCRUMB -->

        <div class="breadcrumb-store">

            <i class="bi bi-house-fill"></i>

            <i class="bi bi-chevron-right"></i>

            Tienda

        </div>


        <!-- BANNER -->

        <section class="store-banner">

            <div class="store-banner-content">

                <h1>
                    Las mejores <span>cartas</span>
                    <br />
                    de tus sagas favoritas
                </h1>

                <p>
                    Yu-Gi-Oh!, Pokémon y Magic,
                    todo en un solo lugar.
                </p>


                <div class="store-benefits">

                    <span>
                        <i class="bi bi-shield-check"></i>
                        Productos originales
                    </span>

                    <span>
                        <i class="bi bi-truck"></i>
                        Envíos seguros
                    </span>

                    <span>
                        <i class="bi bi-star"></i>
                        Calidad garantizada
                    </span>

                </div>

            </div>

        </section>


        <!-- CATEGORÍAS -->

        <div class="store-toolbar">

            <div class="store-tabs">

                <button class="store-tab active">
                    <i class="bi bi-hexagon"></i>
                    Todos
                    <small>(248)</small>
                </button>

                <button class="store-tab">
                    Yu-Gi-Oh!
                    <small>(112)</small>
                </button>

                <button class="store-tab">
                    Pokémon
                    <small>(98)</small>
                </button>

                <button class="store-tab">
                    Magic
                    <small>(26)</small>
                </button>

                <button class="store-tab">
                    Otros
                    <small>(12)</small>
                </button>

            </div>


            <button class="order-button">

                <i class="bi bi-sliders2"></i>

                <span>
                    Ordenar por:
                    <strong>Más recientes</strong>
                </span>

                <i class="bi bi-chevron-down"></i>

            </button>

        </div>


        <!-- PRODUCTOS -->

        <div class="store-products">


            <!-- CARD -->

            <article class="store-product">

                <span class="product-badge new">
                    Nuevo
                </span>

                <button class="product-heart">
                    <i class="bi bi-heart"></i>
                </button>

                <div class="store-product-image">

                    <img src="~/Imagenes/imagen1.jpg"
                         alt="Blue-Eyes White Dragon" />

                </div>


                <div class="store-product-body">

                    <h3>
                        Blue-Eyes White Dragon
                    </h3>

                    <small>
                        Yu-Gi-Oh! | Monstruo
                    </small>

                    <span class="rarity">
                        Ultra Rare
                    </span>

                    <strong class="store-price">
                        Bs 320
                    </strong>

                    <span class="stock">
                        <i class="bi bi-circle-fill"></i>
                        En stock (5)
                    </span>


                    <div class="quantity">
                        <button>−</button>
                        <span>1</span>
                        <button>+</button>
                    </div>


                    <button class="store-cart">
                        <i class="bi bi-cart3"></i>
                        Agregar al carrito
                    </button>

                </div>

            </article>


