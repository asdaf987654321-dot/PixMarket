@using System.Globalization
@{
    ViewData["Title"] = "Panel de Administración";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    // Fecha actual en español
    var cultura = new CultureInfo("es-ES");
    var fechaActual = DateTime.Now.ToString("dd 'de' MMMM 'de' yyyy", cultura);

    var stockBajo = ViewBag.StockBajo as List<PixMarket.Models.Item> ?? new List<PixMarket.Models.Item>();
    var pedidosRecientes = ViewBag.PedidosRecientes as List<PixMarket.Servicios.VentaDto> ?? new List<PixMarket.Servicios.VentaDto>();
    var ventasPorDia = ViewBag.VentasPorDia as List<PixMarket.Servicios.VentaPorDiaDto> ?? new List<PixMarket.Servicios.VentaPorDiaDto>();
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />
    <main class="admin-main">

        <partial name="_AdminTopbar" />
        <section class="admin-content">

            <!-- BIENVENIDA -->
            <div class="admin-welcome">
                <div>
                    <h1>¡Hola, Admin!</h1>
                    <p>Aquí tienes un resumen de lo que está pasando en tu tienda.</p>
                </div>
                <div class="admin-fecha">
                    <i class="bi bi-calendar3"></i>
                    <div>
                        <strong>@fechaActual</strong>
                        <small>Cochabamba, Bolivia</small>
                    </div>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <!-- TARJETAS DE MÉTRICAS -->
            <div class="admin-stats">

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Productos</span>
                        <strong>@ViewBag.TotalProductos</strong>
                    </div>
                </div>

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas del día</span>
                        <strong>Bs @(((decimal)ViewBag.VentasDelDia).ToString("N2"))</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Pedidos pendientes</span>
                        <strong>@ViewBag.PedidosPendientes</strong>
                    </div>
                </div>

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Usuarios registrados</span>
                        <strong>@ViewBag.UsuariosRegistrados</strong>
                    </div>
                </div>

            </div>

            <!-- GRID PRINCIPAL -->
            <div class="admin-grid">

                <!-- GRÁFICO DE VENTAS -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-bar-chart-line"></i> Ventas de los últimos 7 días</h3>
                        <select>
                            <option>Últimos 7 días</option>
                            <option>Últimos 30 días</option>
                        </select>
                    </div>
                    <div style="height: 260px; position: relative;">
                        <canvas id="graficoVentas"></canvas>
                    </div>
                </div>

                <!-- STOCK BAJO -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-exclamation-triangle"></i> Stock bajo</h3>
                        <a asp-controller="Inventario" asp-action="Index">Ver todo →</a>
                    </div>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Carta</th>
                                <th>Categoría</th>
                                <th>Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!stockBajo.Any())
                            {
                                <tr>
                                    <td colspan="3" style="text-align:center; color:#94a3b8; padding: 24px;">
                                        No hay cartas con stock bajo por ahora.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in stockBajo)
                                {
                                    <tr>
                                        <td>@item.Nombre</td>
                                        <td>@item.Categoria</td>
                                        <td>
                                            <span class="stock-badge @(item.Stock <= 2 ? "red" : "orange")">
                                                @item.Stock
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>

            <!-- PEDIDOS RECIENTES -->

            <div class="admin-panel full-width">

                <div class="admin-panel-header">
                    <h3><i class="bi bi-clipboard-list"></i> Pedidos recientes</h3>
                    <a asp-controller="Pedidos" asp-action="Index">Ver todos →</a>
                </div>

                <table class="admin-table">
                    <thead>
                        <tr>
                            <th># Pedido</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!pedidosRecientes.Any())
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; color:#94a3b8; padding: 24px;">
                                    No hay pedidos recientes por ahora.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pedido in pedidosRecientes)
                            {
                                <tr>
                                    <td>#@pedido.Id.ToString("D6")</td>
                                    <td>@pedido.NombreUsuario</td>
                                    <td>Bs @pedido.Total.ToString("N2")</td>
                                    <td>
                                        <span class="estado @(pedido.Estado == "Entregado" ? "completado" : "pendiente")">
                                            @pedido.Estado
                                        </span>
                                    </td>
                                    <td>@pedido.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

            </div>

            <!-- RECORDATORIO -->
            <div class="admin-recordatorio">
                <div class="admin-recordatorio-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <strong>¡Recuerda!</strong>
                    <p>Valida el stock físico antes de confirmar un pedido web. Así evitamos problemas y mantenemos a nuestros duelistas felices.</p>
                </div>
                <div class="admin-recordatorio-frase">
                    <em>Cartas que<br />conectan personas</em>
                </div>
            </div>

        </section>

    </main>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Datos desde el servidor
        const datosVentas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    ventasPorDia.Select(v => new { fecha = v.Fecha, total = v.Total }).ToList()
            ));

        // Si no hay datos, mostramos los últimos 7 días con 0
        let etiquetas = [];
        let valores = [];

        if (datosVentas.length > 0) {
            // Tomamos los últimos 7 días
            const ultimos7 = datosVentas.slice(-7);
            etiquetas = ultimos7.map(d => {
                const fecha = new Date(d.fecha);
                return fecha.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' });
            });
            valores = ultimos7.map(d => d.total);
        } else {
            // Datos vacíos: 7 días en cero
            for (let i = 6; i >= 0; i--) {
                const fecha = new Date();
                fecha.setDate(fecha.getDate() - i);
                etiquetas.push(fecha.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' }));
                valores.push(0);
            }
        }



        // Crear el gráfico
        const ctx = document.getElementById('graficoVentas').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: etiquetas,
                datasets: [{
                    label: 'Ventas (Bs)',
                    data: valores,
                    backgroundColor: 'rgba(45, 212, 191, 0.7)',
                    borderColor: 'rgba(45, 212, 191, 1)',
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return 'Bs ' + value; }
                        }
                    }
                }
            }

        });

    </script>
}
