@model IEnumerable<PixMarket.Servicios.VentaDto>
@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var stats = ViewBag.Stats as PixMarket.Servicios.VentasStatsDto ?? new PixMarket.Servicios.VentasStatsDto();
}
<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="admin-welcome">
                <div>
                    <h1>Ventas</h1>
                    <p>Consulta el historial de ventas entregadas de tu tienda.</p>
                </div>
            </div>

            <div class="admin-stats">

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas del día</span>
                        <strong>Bs @stats.VentasDelDia.ToString("N2")</strong>
                    </div>
                </div>

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas de la semana</span>
                        <strong>Bs @stats.VentasDeLaSemana.ToString("N2")</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Pedidos en el mes</span>
                        <strong>@stats.PedidosEnElMes</strong>
                    </div>
                </div>

                <div class="admin-stat-card purple"
                     title="Muestra cuánto gastó en promedio cada cliente en un pedido durante este mes. Se calcula dividiendo el total vendido del mes entre la cantidad de pedidos entregados del mes.">
                    <div class="admin-stat-icon">
                        <i class="bi bi-calculator"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>
                            Gasto promedio por pedido (mes)
                            <i class="bi bi-info-circle text-muted"
                               title="Total vendido este mes ÷ pedidos entregados este mes."></i>
                        </span>
                        <strong>Bs @stats.TicketPromedio.ToString("N2")</strong>
                    </div>
                </div>

            </div>

            <p class="text-muted" style="font-size: 0.82rem; margin: -8px 0 16px 0;">
                <i class="bi bi-info-circle"></i>
                Las cuatro cifras cuentan solo pedidos <strong>entregados</strong>.
                El <em>gasto promedio por pedido</em> es el total vendido del mes dividido
                entre cuántos pedidos entregados hubo en el mes.
                @if (stats.PedidosEnElMes == 0)
                {
                    <span>Este mes todavía no hay pedidos entregados, por eso muestra Bs 0.00.</span>
                }
            </p>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-cart-check"></i> Ventas recientes (Entregadas)</h3>
                    <span>Últimos 30 días</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th># Venta</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                                <th style="text-align: right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var venta in Model)
                                {
                                    <tr>
                                        <td>#@venta.Id.ToString("D4")</td>
                                        <td>@venta.FechaVenta.ToString("dd/MM/yyyy")</td>
                                        <td>@(venta.NombreUsuario ?? "Cliente")</td>
                                        <td>Bs @venta.Total.ToString("N2")</td>
                                        <td>
                                            <span class="estado @(venta.Estado?.ToLower().Replace(" ", ""))">
                                                @venta.Estado
                                            </span>
                                        </td>
                                        <td style="text-align: right; white-space: nowrap;">
                                            <a asp-action="Detalle" asp-route-id="@venta.Id" class="btn btn-sm btn-outline-info" title="Ver Detalle">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        No hay ventas registradas con el estado entregado.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>
</div>