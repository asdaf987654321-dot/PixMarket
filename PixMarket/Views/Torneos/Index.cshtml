@{
    ViewData["Title"] = "Torneos";
}

<section class="torneos-page">

    <!-- HERO DE TORNEOS -->

    <section class="torneos-hero">

        <div class="torneos-hero-contenido">

            <span class="torneos-label">
                COMPETENCIAS PIXMARKET
            </span>

            <h1>
                Torneos
                <span>PixMarket</span>
            </h1>

            <p>
                Compite, demuestra tu estrategia y forma parte
                de nuestra comunidad de jugadores de cartas
                coleccionables.
            </p>

            <div class="torneos-hero-botones">

                <a href="#proximos-torneos"
                   class="btn-torneo-principal">
                    🏆 Ver torneos
                </a>

                <a href="#como-participar"
                   class="btn-torneo-secundario">
                    ¿Cómo participar?
                </a>

            </div>

        </div>

        <div class="torneos-hero-imagen">

            <div class="torneo-circulo">
                🏆
            </div>

            <div class="torneo-carta carta-1">
                🃏
            </div>

            <div class="torneo-carta carta-2">
                ⚡
            </div>

            <div class="torneo-carta carta-3">
                ♦
            </div>

        </div>

    </section>


    <!-- ESTADISTICAS -->

    <section class="torneos-estadisticas">

        <div class="estadistica-torneo">

            <span class="estadistica-icono">
                🏆
            </span>

            <div>
                <strong>12+</strong>
                <span>Torneos realizados</span>
            </div>

        </div>

        <div class="estadistica-torneo">

            <span class="estadistica-icono">
                👥
            </span>

            <div>
                <strong>250+</strong>
                <span>Jugadores</span>
            </div>

        </div>

        <div class="estadistica-torneo">

            <span class="estadistica-icono">
                🎴
            </span>

            <div>
                <strong>3</strong>
                <span>Juegos disponibles</span>
            </div>

        </div>

        <div class="estadistica-torneo">

            <span class="estadistica-icono">
                ⭐
            </span>

            <div>
                <strong>100%</strong>
                <span>Comunidad</span>
            </div>

        </div>

    </section>


    <!-- PROXIMOS TORNEOS -->

    <section class="proximos-torneos"
             id="proximos-torneos">

        <div class="torneos-titulo">

            <div>
                <span>★</span>

                <h2>
                    Próximos torneos
                </h2>
            </div>

            <p>
                Elige tu juego y prepárate para competir.
            </p>

        </div>


        <div class="torneos-grid">


            <!-- POKEMON -->

            <article class="torneo-card torneo-pokemon">

                <div class="torneo-card-header">

                    <span class="torneo-juego">
                        POKÉMON
                    </span>

                    <span class="torneo-estado">
                        Próximamente
                    </span>

                </div>

                <div class="torneo-card-icon">
                    ⚡
                </div>

                <h3>
                    Pokémon TCG
                </h3>

                <p class="torneo-subtitulo">
                    Campeonato PixMarket
                </p>

                <div class="torneo-datos">

                    <div>
                        <span>📅 Fecha</span>
                        <strong>25 Octubre 2026</strong>
                    </div>

                    <div>
                        <span>🕐 Hora</span>
                        <strong>15:00</strong>
                    </div>

                    <div>
                        <span>👥 Cupos</span>
                        <strong>32 jugadores</strong>
                    </div>

                </div>

                <div class="torneo-premio">

                    <span>🏆 Premio</span>

                    <strong>
                        Bs 1.500
                    </strong>

                </div>

                <button class="btn-inscribirse">
                    Inscribirme
                </button>

            </article>


            <!-- YU GI OH -->

            <article class="torneo-card torneo-yugioh">

                <div class="torneo-card-header">

                    <span class="torneo-juego">
                        YU-GI-OH!
                    </span>

                    <span class="torneo-estado">
                        Inscripciones
                    </span>

                </div>

                <div class="torneo-card-icon">
                    🎴
                </div>

                <h3>
                    Yu-Gi-Oh! TCG
                </h3>

                <p class="torneo-subtitulo">
                    Duelistas de Cochabamba
                </p>

                <div class="torneo-datos">

                    <div>
                        <span>📅 Fecha</span>
                        <strong>01 Noviembre 2026</strong>
                    </div>

                    <div>
                        <span>🕐 Hora</span>
                        <strong>14:00</strong>
                    </div>

                    <div>
                        <span>👥 Cupos</span>
                        <strong>40 jugadores</strong>
                    </div>

                </div>

                <div class="torneo-premio">

                    <span>🏆 Premio</span>

                    <strong>
                        Bs 2.000
                    </strong>

                </div>

                <button class="btn-inscribirse">
                    Inscribirme
                </button>

            </article>


            <!-- MAGIC -->

            <article class="torneo-card torneo-magic">

                <div class="torneo-card-header">

                    <span class="torneo-juego">
                        MAGIC
                    </span>

                    <span class="torneo-estado">
                        Próximamente
                    </span>

                </div>

                <div class="torneo-card-icon">
                    ♦
                </div>

                <h3>
                    Magic: The Gathering
                </h3>

                <p class="torneo-subtitulo">
                    Magic Weekend
                </p>

                <div class="torneo-datos">

                    <div>
                        <span>📅 Fecha</span>
                        <strong>08 Noviembre 2026</strong>
                    </div>

                    <div>
                        <span>🕐 Hora</span>
                        <strong>16:00</strong>
                    </div>

                    <div>
                        <span>👥 Cupos</span>
                        <strong>24 jugadores</strong>
                    </div>

                </div>

                <div class="torneo-premio">

                    <span>🏆 Premio</span>

                    <strong>
                        Bs 1.200
                    </strong>

                </div>

                <button class="btn-inscribirse">
                    Inscribirme
                </button>

            </article>

        </div>

    </section>


    <!-- COMO PARTICIPAR -->

    <section class="como-participar"
             id="como-participar">

        <div class="como-participar-titulo">

            <span>★</span>

            <h2>
                ¿Cómo participar?
            </h2>

            <p>
                Participar en nuestros torneos es muy sencillo.
            </p>

        </div>


        <div class="pasos-torneo">

            <div class="paso-torneo">

                <div class="paso-numero">
                    01
                </div>

                <div class="paso-icono">
                    🎮
                </div>

                <h3>
                    Elige tu juego
                </h3>

                <p>
                    Selecciona el torneo de Pokémon,
                    Yu-Gi-Oh! o Magic que quieras jugar.
                </p>

            </div>


            <div class="paso-torneo">

                <div class="paso-numero">
                    02
                </div>

                <div class="paso-icono">
                    📝
                </div>

                <h3>
                    Inscríbete
                </h3>

                <p>
                    Registra tu participación y reserva
                    tu lugar en el torneo.
                </p>

            </div>


            <div class="paso-torneo">

                <div class="paso-numero">
                    03
                </div>

                <div class="paso-icono">
                    🏆
                </div>

                <h3>
                    Compite
                </h3>

                <p>
                    Prepara tu mejor estrategia y
                    disfruta de la competencia.
                </p>

            </div>


            <div class="paso-torneo">

                <div class="paso-numero">
                    04
                </div>

                <div class="paso-icono">
                    ⭐
                </div>

                <h3>
                    Gana premios
                </h3>

                <p>
                    Los mejores jugadores podrán
                    obtener premios y reconocimientos.
                </p>

            </div>

        </div>

    </section>


    <!-- BANNER FINAL -->

    <section class="torneo-final">

        <div>

            <span>
                PIXMARKET COMMUNITY
            </span>

            <h2>
                Más que cartas,
                <strong>una comunidad.</strong>
            </h2>

            <p>
                Conoce nuevos jugadores, participa en eventos
                y disfruta de tu juego favorito.
            </p>

        </div>

        <a href="#proximos-torneos">
            Ver próximos torneos →
        </a>

    </section>

</section>