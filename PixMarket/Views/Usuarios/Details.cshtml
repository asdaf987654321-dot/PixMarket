@model PixMarket.Servicios.UsuarioDto

@{
    ViewData["Title"] = "Ver usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var estaActivo = string.Equals(Model.Estado, "Activo", StringComparison.OrdinalIgnoreCase);
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1>@Model.Nombre</h1>
                    <p>Información de la cuenta #@Model.Id</p>
                </div>
                <div style="white-space: nowrap;">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a asp-action="Gestion" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-body text-center">
                            <i class="bi bi-person-circle" style="font-size: 4rem; color: #0a9992;"></i>
                            <h4 class="fw-bold mt-2 mb-1">@Model.Nombre</h4>
                            <p class="text-muted mb-2">@Model.Correo</p>
                            <span class="estado @(estaActivo ? "completado" : "pendiente")">
                                @(string.IsNullOrWhiteSpace(Model.Estado) ? "Activo" : Model.Estado)
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="admin-panel">
                        <div class="admin-panel-header">
                            <h3><i class="bi bi-person-lines-fill"></i> Datos de la cuenta</h3>
                        </div>

                        <div class="table-responsive">
                            <table class="admin-table">
                                <tbody>
                                    <tr>
                                        <th style="width: 40%;">Identificador</th>
                                        <td>#@Model.Id</td>
                                    </tr>
                                    <tr>
                                        <th>Nombre</th>
                                        <td>@Model.Nombre</td>
                                    </tr>
                                    <tr>
                                        <th>Correo</th>
                                        <td>@Model.Correo</td>
                                    </tr>
                                    <tr>
                                        <th>Teléfono</th>
                                        <td>@(string.IsNullOrWhiteSpace(Model.Telefono) ? "Sin registrar" : Model.Telefono)</td>
                                    </tr>
                                    <tr>
                                        <th>Rol</th>
                                        <td>@Model.Rol</td>
                                    </tr>
                                    <tr>
                                        <th>Estado</th>
                                        <td>
                                            <span class="estado @(estaActivo ? "completado" : "pendiente")">
                                                @(string.IsNullOrWhiteSpace(Model.Estado) ? "Activo" : Model.Estado)
                                            </span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="admin-panel mt-3">
                        <div class="admin-panel-header">
                            <h3><i class="bi bi-person-gear"></i> Estado de la cuenta</h3>
                        </div>
                        <div class="p-3">
                            <p class="text-muted mb-3">
                                @(estaActivo
                                    ? "Esta cuenta está activa. Puedes suspenderla para que no pueda iniciar sesión."
                                    : "Esta cuenta está suspendida. Actívala para que el usuario vuelva a entrar.")
                            </p>

                            <form method="post" asp-action="CambiarEstado" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="estado" value="@(estaActivo ? "Suspendido" : "Activo")" />
                                <button type="submit"
                                        class="btn @(estaActivo ? "btn-outline-danger" : "btn-success")"
                                        style="@(estaActivo ? "" : "background: #10afa5; border: none;")">
                                    <i class="bi @(estaActivo ? "bi-person-dash" : "bi-person-check")"></i>
                                    @(estaActivo ? "Suspender usuario" : "Activar usuario")
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Gestion" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver a Usuarios
                </a>
            </div>

        </section>

    </main>
</div>
