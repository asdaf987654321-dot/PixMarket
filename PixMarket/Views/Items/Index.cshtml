@{
    ViewData["Title"] = "Gestión de Cartas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@model List<Item>

<section class="admin-content">

    <div class="admin-welcome">
        <div>
            <h1>Gestión de cartas</h1>
            <p>Administra el catálogo de productos de la tienda.</p>
        </div>
        <a asp-action="Create" class="btn btn-success" style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; height: fit-content;">
            <i class="bi bi-plus-circle"></i> Nueva carta
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="admin-panel text-center p-5">
            <i class="bi bi-inbox" style="font-size: 3rem; color: #9aadb8;"></i>
            <p class="mt-3 mb-0" style="color: #5f788a;">No hay cartas registradas todavía.</p>
        </div>
    }
    else
    {
        <div class="admin-panel">
            <div class="admin-panel-header">
                <h3><i class="bi bi-box-seam"></i> Cartas registradas</h3>
                <span>@Model.Count producto(s)</span>
            </div>

            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Juego</th>
                            <th>Categoría</th>
                            <th>Rareza</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImagenRuta))
                                    {
                                        <img src="@Url.Content(item.ImagenRuta)" alt="@item.Nombre" style="width: 34px; height: 46px; object-fit: contain;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image" style="font-size: 1.3rem; color: #9aadb8;"></i>
                                    }
                                </td>
                                <td>@item.Nombre</td>
                                <td>@item.Juego</td>
                                <td>@item.Categoria</td>
                                <td>@item.Rareza</td>
                                <td>Bs @item.Precio.ToString("N2")</td>
                                <td>@item.Stock</td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al panel
        </a>
    </div>

</section>