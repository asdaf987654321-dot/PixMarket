@model PixMarket.Models.Configuracion

@{
    ViewData["Title"] = "Configuración";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Configuración</h1>
                    <p>Ajusta los datos generales de tu tienda.</p>
                </div>
                <button type="submit" form="form-configuracion" class="btn btn-success"
                        style="background: linear-gradient(90deg, #10afa5, #0a9992); border: none; height: fit-content;">
                    <i class="bi bi-check2-circle"></i> Guardar cambios
                </button>
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form id="form-configuracion" method="post" asp-controller="Configuracion" asp-action="Guardar">
                @Html.AntiForgeryToken()

                <!-- ============ DATOS DE LA TIENDA ============ -->
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-shop"></i> Datos de la tienda</h3>
                    </div>

                    <div class="row g-3 p-3">
                        <div class="col-md-6">
                            <label asp-for="NombreTienda" class="form-label">Nombre de la tienda</label>
                            <input asp-for="NombreTienda" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CorreoContacto" class="form-label">Correo de contacto</label>
                            <input asp-for="CorreoContacto" type="email" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono</label>
                            <input asp-for="Telefono" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Moneda" class="form-label">Moneda</label>
                            <select asp-for="Moneda" class="form-select">
                                <option value="Bs">Boliviano (Bs)</option>
                                <option value="USD">Dólar (USD)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Direccion" class="form-label">Dirección</label>
                            <input asp-for="Direccion" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Horario" class="form-label">Horario de atención</label>
                            <input asp-for="Horario" class="form-control" />
                        </div>
                    </div>
                </div>


               <!--Preferencias-->
                <div class="admin-panel mt-3">
                    <div class="admin-panel-header">
                        <h3><i class="bi bi-sliders"></i> Preferencias</h3>
                    </div>
                    <div class="p-3">

                        <!-- Switch 1: Notificar stock bajo -->
                        <div class="form-check form-switch mb-3">
                            
                            <input type="checkbox"

                                name="NotificarStockBajo"
                                value="true"
                                class="form-check-input"
                                role="switch"
                                id="switchStockBajo"
                                @(Model.NotificarStockBajo ? "checked" : "") />
                            <input type="hidden" name="NotificarStockBajo" value="false" />
                            <label class="form-check-label" for="switchStockBajo">
                                Notificar cuando el stock de una carta esté bajo
                            </label>
                        </div>

                        <!-- Switch 2: Avisos de nuevos pedidos -->
                        <div class="form-check form-switch mb-2">
                            
                            <input type="checkbox"
                                name="AvisosNuevosPedidos"
                                value="true"
                                class="form-check-input"
                                role="switch"
                                id="switchNuevosPedidos"
                                @(Model.AvisosNuevosPedidos ? "checked" : "") />
                            <input type="hidden" name="AvisosNuevosPedidos" value="false" />
                            <label class="form-check-label" for="switchNuevosPedidos">
                                Recibir aviso de nuevos pedidos
                            </label>
                        </div>
        



                    </div>
                </div>


                <div class="mt-3">
                    <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al panel
                    </a>
                </div>

            </form>

        </section>

    </main>

</div>