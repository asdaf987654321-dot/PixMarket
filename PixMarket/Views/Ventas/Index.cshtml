@model IEnumerable<PixMarket.Servicios.VentaDto>
@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var stats = ViewBag.Stats as PixMarket.Servicios.VentasStatsDto ?? new PixMarket.Servicios.VentasStatsDto();
}
<div class="admin-layout">

    <partial name="_AdminSidebar" />

    <main class="admin-main">

        <partial name="_AdminTopbar" />

        <section class="admin-content">

            <div class="admin-welcome">
                <div>
                    <h1>Ventas</h1>
                    <p>Consulta el historial de ventas entregadas de tu tienda.</p>
                </div>
            </div>

            <div class="admin-stats">

                <div class="admin-stat-card green">
                    <div class="admin-stat-icon">
                        <i class="bi bi-cart-check"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas del día</span>
                        <strong>Bs @stats.VentasDelDia.ToString("N2")</strong>
                    </div>
                </div>

                <div class="admin-stat-card blue">
                    <div class="admin-stat-icon">
                        <i class="bi bi-calendar-week"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ventas de la semana</span>
                        <strong>Bs @stats.VentasDeLaSemana.ToString("N2")</strong>
                    </div>
                </div>

                <div class="admin-stat-card orange">
                    <div class="admin-stat-icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Pedidos en el mes</span>
                        <strong>@stats.PedidosEnElMes</strong>
                    </div>
                </div>

                <div class="admin-stat-card purple">
                    <div class="admin-stat-icon">
                        <i class="bi bi-ticket-perforated"></i>
                    </div>
                    <div class="admin-stat-info">
                        <span>Ticket promedio</span>
                        <strong>Bs @stats.TicketPromedio.ToString("N2")</strong>
                    </div>
                </div>

            </div>

            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3><i class="bi bi-cart-check"></i> Ventas recientes (Entregadas)</h3>
                    <span>Últimos 30 días</span>
                </div>

                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th># Venta</th>
                                <th>Fecha</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var venta in Model)
                                {
                                    <tr>
                                        <td>#@venta.Id.ToString("D4")</td>
                                        <td>@venta.FechaVenta.ToString("dd/MM/yyyy")</td>
                                        <td>@(venta.NombreUsuario ?? "Cliente")</td>
                                        <td>Bs @venta.Total.ToString("N2")</td>
                                        <td>
                                            <span class="estado completado">@venta.Estado</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        No hay ventas registradas con el estado entregado.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>
</div>