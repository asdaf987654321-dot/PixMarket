@{
    ViewData["Title"] = "Tienda";
}

@model List<Item>


<div class="store-layout">


    <!-- =================================================
         SIDEBAR
         ================================================= -->

    <aside class="store-sidebar">

        <div class="sidebar-title">
            <i class="bi bi-shop"></i>
            Tienda
        </div>


        <a class="sidebar-link active">
            <i class="bi bi-shop"></i>
            Tienda
        </a>

        <a class="sidebar-link">
            <i class="bi bi-collection"></i>
            Productos
        </a>

        <a class="sidebar-link">
            <i class="bi bi-grid"></i>
            Categorías
        </a>

        <a class="sidebar-link">
            <i class="bi bi-tag"></i>
            Ofertas
        </a>


        <div class="sidebar-separator"></div>


        <!-- FILTROS -->

        <div class="filter-title">

            <i class="bi bi-funnel"></i>

            Filtros

        </div>


        <form method="get"
              asp-controller="Categorias"
              asp-action="Index"
              id="filtros-form"
              style="margin: 0;">

            <input type="hidden" name="buscar" value="@(ViewBag.Buscar ?? "")" />

            <input type="hidden" name="juego" value="@(ViewBag.Juego ?? "")" />


            <!-- JUEGO -->

            <div class="filter-section">

                <div class="filter-heading">
                    Juego

                    <i class="bi bi-chevron-up"></i>
                </div>


                <label class="check-option">

                    <input type="checkbox"
                           name="juegos"
                           value="Yu-Gi-Oh!"
                           @(ViewBag.SelJuegos?.Contains("Yu-Gi-Oh!") == true ? "checked" : "") />

                    <span></span>

                    Yu-Gi-Oh!

                </label>


                <label class="check-option">

                    <input type="checkbox"
                           name="juegos"
                           value="Pokémon"
                           @(ViewBag.SelJuegos?.Contains("Pokémon") == true ? "checked" : "") />

                    <span></span>

                    Pokémon

                </label>


                <label class="check-option">

                    <input type="checkbox"
                           name="juegos"
                           value="Magic: The Gathering"
                           @(ViewBag.SelJuegos?.Contains("Magic: The Gathering") == true ? "checked" : "") />

                    <span></span>

                    Magic: The Gathering

                </label>

            </div>


            <!-- CATEGORÍA -->

            <div class="filter-section">

                <div class="filter-heading">
                    Categoría

                    <i class="bi bi-chevron-up"></i>
                </div>


                <label class="check-option">
                    <input type="checkbox" name="categorias" value="Monstruo"
                           @(ViewBag.SelCategorias?.Contains("Monstruo") == true ? "checked" : "") />
                    <span></span>
                    Monstruo
                </label>


                <label class="check-option">
                    <input type="checkbox" name="categorias" value="Hechizo"
                           @(ViewBag.SelCategorias?.Contains("Hechizo") == true ? "checked" : "") />
                    <span></span>
                    Hechizo
                </label>


                <label class="check-option">
                    <input type="checkbox" name="categorias" value="Trampa"
                           @(ViewBag.SelCategorias?.Contains("Trampa") == true ? "checked" : "") />
                    <span></span>
                    Trampa
                </label>


                <label class="check-option">
                    <input type="checkbox" name="categorias" value="Entrenador"
                           @(ViewBag.SelCategorias?.Contains("Entrenador") == true ? "checked" : "") />
                    <span></span>
                    Entrenador
                </label>


                <label class="check-option">
                    <input type="checkbox" name="categorias" value="Otros"
                           @(ViewBag.SelCategorias?.Contains("Otros") == true ? "checked" : "") />
                    <span></span>
                    Otros
                </label>

            </div>


            <!-- RAREZA -->

            <div class="filter-section">

                <div class="filter-heading">
                    Rareza

                    <i class="bi bi-chevron-up"></i>
                </div>


                <label class="check-option">
                    <input type="checkbox" name="rarezas" value="Common"
                           @(ViewBag.SelRarezas?.Contains("Common") == true ? "checked" : "") />
                    <span></span>
                    Common
                </label>


                <label class="check-option">
                    <input type="checkbox" name="rarezas" value="Uncommon"
                           @(ViewBag.SelRarezas?.Contains("Uncommon") == true ? "checked" : "") />
                    <span></span>
                    Uncommon
                </label>


                <label class="check-option">
                    <input type="checkbox" name="rarezas" value="Rare"
                           @(ViewBag.SelRarezas?.Contains("Rare") == true ? "checked" : "") />
                    <span></span>
                    Rare
                </label>


                <label class="check-option">
                    <input type="checkbox" name="rarezas" value="Super Rare"
                           @(ViewBag.SelRarezas?.Contains("Super Rare") == true ? "checked" : "") />
                    <span></span>
                    Super Rare
                </label>


                <label class="check-option">
                    <input type="checkbox" name="rarezas" value="Ultra Rare"
                           @(ViewBag.SelRarezas?.Contains("Ultra Rare") == true ? "checked" : "") />
                    <span></span>
                    Ultra Rare
                </label>


                <label class="check-option">
                    <input type="checkbox" name="rarezas" value="Secret Rare"
                           @(ViewBag.SelRarezas?.Contains("Secret Rare") == true ? "checked" : "") />
                    <span></span>
                    Secret Rare
                </label>

            </div>


            <!-- PRECIO -->

            <div class="filter-section">

                <div class="filter-heading">
                    Rango de precio

                    <i class="bi bi-chevron-up"></i>
                </div>


                @{
                    var maxSlider = Math.Max(100, (int)Math.Ceiling((decimal)ViewBag.PrecioMaximoReal / 100) * 100);
                }

                <div class="price-values">

                    <span class="valor-min">
                        Bs 0
                    </span>

                    <span class="valor-max">
                        Bs @maxSlider.ToString("N0")+
                    </span>

                </div>


                <div class="price-ranges">
                    <input type="hidden" name="precioMin" class="precio-min-hidden" value="@(ViewBag.PrecioMin?.ToString() ?? "")" />
                    <input type="hidden" name="precioMax" class="precio-max-hidden" value="@(ViewBag.PrecioMax?.ToString() ?? "")" />
                </div>


                <div class="fake-slider"
                     data-max="@maxSlider"
                     data-min-val="@(ViewBag.PrecioMin?.ToString() ?? "")"
                     data-max-val="@(ViewBag.PrecioMax?.ToString() ?? "")">

                    <div class="slider-line"></div>

                    <input type="range"
                           class="slider-input min"
                           min="0"
                           max="@maxSlider"
                           value="@((int)(ViewBag.PrecioMin ?? 0))" />

                    <input type="range"
                           class="slider-input max"
                           min="0"
                           max="@maxSlider"
                           value="@((int)(ViewBag.PrecioMax ?? maxSlider))" />

                </div>


                <button type="submit" class="apply-filter">
                    Aplicar filtros
                </button>

            </div>

        </form>

    </aside>


    <!-- =================================================
         CONTENIDO
         ================================================= -->

    <main class="store-content">


        <!-- BREADCRUMB -->

        <div class="breadcrumb-store">

            <i class="bi bi-house-fill"></i>

            <i class="bi bi-chevron-right"></i>

            Tienda

        </div>


        <!-- BANNER -->

        <section class="store-banner">

            <div class="store-banner-content">

                <h1>
                    Las mejores <span>cartas</span>
                    <br />
                    de tus sagas favoritas
                </h1>

                <p>
                    Yu-Gi-Oh!, Pokémon y Magic,
                    todo en un solo lugar.
                </p>


                <div class="store-benefits">

                    <span>
                        <i class="bi bi-shield-check"></i>
                        Productos originales
                    </span>

                    <span>
                        <i class="bi bi-truck"></i>
                        Envíos seguros
                    </span>

                    <span>
                        <i class="bi bi-star"></i>
                        Calidad garantizada
                    </span>

                </div>

            </div>

        </section>


        <!-- CATEGORÍAS -->

        <div class="store-toolbar">

            <div class="store-tabs">

                <a asp-controller="Categorias"
                   asp-action="Index"
                   asp-route-buscar="@(string.IsNullOrEmpty(ViewBag.Buscar?.ToString()) ? null : ViewBag.Buscar)"
                   asp-route-juego=""
                   class="store-tab @(string.IsNullOrEmpty((string)ViewBag.Juego) ? "active" : "")">

                    <i class="bi bi-hexagon"></i>

                    Todos

                    <small>(@ViewBag.TotalItems)</small>

                </a>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   asp-route-buscar="@(string.IsNullOrEmpty(ViewBag.Buscar?.ToString()) ? null : ViewBag.Buscar)"
                   asp-route-juego="Yu-Gi-Oh!"
                   class="store-tab @((string)ViewBag.Juego == "Yu-Gi-Oh!" ? "active" : "")">

                    Yu-Gi-Oh!

                    <small>(@ViewBag.CYgo)</small>

                </a>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   asp-route-buscar="@(string.IsNullOrEmpty(ViewBag.Buscar?.ToString()) ? null : ViewBag.Buscar)"
                   asp-route-juego="Pokémon"
                   class="store-tab @((string)ViewBag.Juego == "Pokémon" ? "active" : "")">

                    Pokémon

                    <small>(@ViewBag.CPokemon)</small>

                </a>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   asp-route-buscar="@(string.IsNullOrEmpty(ViewBag.Buscar?.ToString()) ? null : ViewBag.Buscar)"
                   asp-route-juego="Magic: The Gathering"
                   class="store-tab @((string)ViewBag.Juego == "Magic: The Gathering" ? "active" : "")">

                    Magic

                    <small>(@ViewBag.CMagic)</small>

                </a>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   asp-route-buscar="@(string.IsNullOrEmpty(ViewBag.Buscar?.ToString()) ? null : ViewBag.Buscar)"
                   asp-route-juego="Otros"
                   class="store-tab @((string)ViewBag.Juego == "Otros" ? "active" : "")">

                    Otros

                    <small>(@ViewBag.COtros)</small>

                </a>

            </div>


            <button class="order-button">

                <i class="bi bi-sliders2"></i>

                <span>
                    Ordenar por:
                    <strong>Más recientes</strong>
                </span>

                <i class="bi bi-chevron-down"></i>

            </button>

        </div>


        <!-- RESULTADO DE BÚSQUEDA -->

        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar?.ToString()))
        {
            <div class="search-result-bar">

                <i class="bi bi-search"></i>

                <span>
                    @Model.Count resultados para
                    <strong>"@ViewBag.Buscar"</strong>
                </span>

                <a asp-controller="Categorias"
                   asp-action="Index"
                   class="search-result-clear">
                    Limpiar búsqueda
                </a>

            </div>
        }


        <!-- PRODUCTOS -->

        <div class="store-products">

            @if (!Model.Any())
            {
                <div class="store-empty">
                    <i class="bi bi-inbox" style="font-size: 2.5rem; color: #9aadb8;"></i>
                    <p class="mb-0 mt-2">No hay cartas que coincidan con la búsqueda o los filtros.</p>

                    <a asp-controller="Categorias"
                       asp-action="Index"
                       class="btn btn-sm btn-outline-primary mt-3">
                        Ver todas las cartas
                    </a>
                </div>
            }

            @foreach (var item in Model)
            {
                <article class="store-product">

                    @if (item.Stock > 0 && item.Stock <= 3)
                    {
                        <span class="product-badge offer">
                            Stock bajo
                        </span>
                    }

                    <button class="product-heart">
                        <i class="bi bi-heart"></i>
                    </button>

                    <div class="store-product-image">

                        <img src="@Api.UrlImagen(item.ImagenRuta, Url.Content("~/Imagenes/imagen1.jpg"))"
                             alt="@item.Nombre" />

                    </div>

                    <div class="store-product-body">

                        <h3>
                            @item.Nombre
                        </h3>

                        <small>
                            @item.Juego | @item.Categoria
                        </small>

                        <span class="rarity">
                            @item.Rareza
                        </span>

                        <strong class="store-price">
                            Bs @item.Precio.ToString("N2")
                        </strong>

                        <span class="stock" style="@(item.Stock == 0 ? "color:#df5960" : "")">
                            <i class="bi bi-circle-fill"></i>
                            @(item.Stock == 0 ? "Agotado" : $"En stock ({item.Stock})")
                        </span>


                        <form method="post"
                              asp-controller="Carrito"
                              asp-action="Agregar"
                              class="store-cart-form"
                              style="margin: 0;">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="id" value="@item.Id" />

                            <div class="quantity" data-stock="@item.Stock">
                                <button type="button" class="btn-qty-less">−</button>
                                <span class="qty-value">1</span>
                                <button type="button" class="btn-qty-more">+</button>
                            </div>

                            <input type="hidden" name="cantidad" class="qty-hidden" value="1" />

                            <button type="submit" class="store-cart">
                                <i class="bi bi-cart3"></i>
                                Agregar al carrito
                            </button>

                        </form>

                    </div>

                </article>
            }

        </div>

    </main>

</div>