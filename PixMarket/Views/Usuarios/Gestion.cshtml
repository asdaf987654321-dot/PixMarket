                                <td>Usuario</td>
                                <td>71234567</td>
                                <td><span class="estado completado">Activo</span></td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a href="#" class="btn btn-sm btn-outline-info" title="Ver"><i class="bi bi-eye"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-danger" title="Suspender"><i class="bi bi-person-dash"></i></a>
                                </td>
                            </tr>
                            <tr>
                                <td>Ana Rojas</td>
                                <td>ana@correo.com</td>
                                <td>Usuario</td>
                                <td>79820134</td>
                                <td><span class="estado completado">Activo</span></td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a href="#" class="btn btn-sm btn-outline-info" title="Ver"><i class="bi bi-eye"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-danger" title="Suspender"><i class="bi bi-person-dash"></i></a>
                                </td>
                            </tr>
                            <tr>
                                <td>Diego Fuentes</td>
                                <td>diego@correo.com</td>
                                <td>Usuario</td>
                                <td>73456789</td>
                                <td><span class="estado pendiente">Pendiente</span></td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a href="#" class="btn btn-sm btn-outline-info" title="Ver"><i class="bi bi-eye"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-danger" title="Suspender"><i class="bi bi-person-dash"></i></a>
                                </td>
                            </tr>
                            <tr>
                                <td>Admin</td>
                                <td>Admin@gmail</td>
                                <td>Administrador</td>
                                <td>71112233</td>
                                <td><span class="estado completado">Activo</span></td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <a href="#" class="btn btn-sm btn-outline-info" title="Ver"><i class="bi bi-eye"></i></a>
                                    <a href="#" class="btn btn-sm btn-outline-warning" title="Editar"><i class="bi bi-pencil"></i></a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="mt-3">
                <a asp-controller="Usuarios" asp-action="Administrador" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al panel
                </a>
            </div>

        </section>

    </main>

</div>